{%- comment -%}
  The brand book's cover frame — a pixel-stepped border on all four sides.

  Four strips rather than one clever border-image: the top and bottom use the
  same tile as gc2-edge, and the sides use that tile TRANSPOSED (x and y
  swapped), so no CSS rotation is involved and nothing has to know the
  container's size. The strips run the full width and height, so the four
  corners are where two solid bands overlap — which is exactly how the corners
  look on the cover.

  Params:
    id     (required) unique per instance; pattern ids collide otherwise, and a
           duplicate silently makes every later strip reuse the first colour.
           MUST be pre-assigned — {% render %} does not evaluate filters.
    tone   colour token for the border. Default '--c-purple'.
    scale  size of one step. 1 = 20px band. Default 2, giving a 40px band.
{%- endcomment -%}
{%- assign tone  = tone  | default: '--c-purple' -%}
{%- assign scale = scale | default: 2 -%}
{%- assign band  = 20 | times: scale -%}
{%- assign long  = 40 | times: scale -%}
{%- assign h_path = 'M0 20 L0 16 L4 16 L4 12 L8 12 L8 8 L12 8 L12 4 L16 4 L16 0 L20 0 L20 4 L24 4 L24 8 L28 8 L28 12 L32 12 L32 16 L36 16 L36 20 Z' -%}
{%- assign v_path = 'M20 0 L16 0 L16 4 L12 4 L12 8 L8 8 L8 12 L4 12 L4 16 L0 16 L0 20 L4 20 L4 24 L8 24 L8 28 L12 28 L12 32 L16 32 L16 36 L20 36 Z' -%}

<div class="gc2-frame" aria-hidden="true" style="--fr:{{ band }}px">
  <span class="gc2-frame-t">
    <svg width="100%" height="{{ band }}" focusable="false" role="presentation">
      <defs><pattern id="gc2fr-t-{{ id }}" width="{{ long }}" height="{{ band }}" patternUnits="userSpaceOnUse">
        <g transform="scale({{ scale }})"><path d="{{ h_path }}" fill="var({{ tone }})"></path></g>
      </pattern></defs>
      <rect width="100%" height="100%" fill="url(#gc2fr-t-{{ id }})"></rect>
    </svg>
  </span>
  <span class="gc2-frame-b">
    <svg width="100%" height="{{ band }}" focusable="false" role="presentation">
      <defs><pattern id="gc2fr-b-{{ id }}" width="{{ long }}" height="{{ band }}" patternUnits="userSpaceOnUse">
        <g transform="scale({{ scale }})"><path d="{{ h_path }}" fill="var({{ tone }})"></path></g>
      </pattern></defs>
      <rect width="100%" height="100%" fill="url(#gc2fr-b-{{ id }})"></rect>
    </svg>
  </span>
  <span class="gc2-frame-l">
    <svg width="{{ band }}" height="100%" focusable="false" role="presentation">
      <defs><pattern id="gc2fr-l-{{ id }}" width="{{ band }}" height="{{ long }}" patternUnits="userSpaceOnUse">
        <g transform="scale({{ scale }})"><path d="{{ v_path }}" fill="var({{ tone }})"></path></g>
      </pattern></defs>
      <rect width="100%" height="100%" fill="url(#gc2fr-l-{{ id }})"></rect>
    </svg>
  </span>
  <span class="gc2-frame-r">
    <svg width="{{ band }}" height="100%" focusable="false" role="presentation">
      <defs><pattern id="gc2fr-r-{{ id }}" width="{{ band }}" height="{{ long }}" patternUnits="userSpaceOnUse">
        <g transform="scale({{ scale }})"><path d="{{ v_path }}" fill="var({{ tone }})"></path></g>
      </pattern></defs>
      <rect width="100%" height="100%" fill="url(#gc2fr-r-{{ id }})"></rect>
    </svg>
  </span>
</div>
