{%- comment -%}
  Round jelly gummy. Circular silhouette (client: "gummy should be round only"),
  but a SOFT translucent finish — diffuse specular + inner glow — so it reads as
  candy rather than a glossy marble.
  Params: tone (a colour-token name, e.g. '--c-cherry'), id (unique)
  All colour derives from the token via color-mix() — no raw hex anywhere.
{%- endcomment -%}
{%- assign base  = 'var(' | append: tone | append: ')' -%}
{%- assign light = 'color-mix(in srgb, var(' | append: tone | append: ') 50%, white)' -%}
{%- assign dark  = 'color-mix(in srgb, var(' | append: tone | append: ') 76%, black)' -%}
<svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" class="gcg" role="img" aria-hidden="true">
  <defs>
    <radialGradient id="body-{{ id }}" cx="36%" cy="30%" r="80%">
      <stop offset="0%"   stop-color="{{ light }}"/>
      <stop offset="52%"  stop-color="{{ base }}"/>
      <stop offset="100%" stop-color="{{ dark }}"/>
    </radialGradient>
    {%- comment -%} light passing through the jelly, pooling low {%- endcomment -%}
    <radialGradient id="inner-{{ id }}" cx="50%" cy="68%" r="58%">
      <stop offset="0%"   stop-color="var(--c-surface)" stop-opacity=".26"/>
      <stop offset="72%"  stop-color="var(--c-surface)" stop-opacity="0"/>
    </radialGradient>
    {%- comment -%} ambient flavour glow on the ground {%- endcomment -%}
    <radialGradient id="glow-{{ id }}" cx="50%" cy="52%" r="52%">
      <stop offset="0%"   stop-color="{{ base }}" stop-opacity=".28"/>
      <stop offset="100%" stop-color="{{ base }}" stop-opacity="0"/>
    </radialGradient>
    {%- comment -%} DIFFUSE specular — soft falloff. A hard-edged ellipse here is
        exactly what made the old version read as a marble. {%- endcomment -%}
    <radialGradient id="hi-{{ id }}" cx="50%" cy="50%" r="50%">
      <stop offset="0%"   stop-color="var(--c-surface)" stop-opacity=".42"/>
      <stop offset="58%"  stop-color="var(--c-surface)" stop-opacity=".08"/>
      <stop offset="100%" stop-color="var(--c-surface)" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <circle cx="60" cy="60" r="56" fill="url(#glow-{{ id }})"/>
  <ellipse cx="62" cy="110" rx="30" ry="6" fill="var(--c-ink)" opacity=".12"/>

  {%- comment -%} round body — a true circle, softened by the gradients {%- endcomment -%}
  <circle cx="60" cy="58" r="49" fill="url(#body-{{ id }})"/>
  <circle cx="60" cy="58" r="49" fill="url(#inner-{{ id }})"/>

  {%- comment -%} soft highlight, plus a small low bounce-light {%- endcomment -%}
  <ellipse cx="43" cy="38" rx="20" ry="14" fill="url(#hi-{{ id }})" transform="rotate(-22 43 38)"/>
  <ellipse cx="80" cy="84" rx="9" ry="5" fill="var(--c-surface)" opacity=".13" transform="rotate(-18 80 84)"/>
</svg>
