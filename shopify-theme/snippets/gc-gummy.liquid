{%- comment -%}
  Glossy tactile gummy. Params: c1 (light), c2 (base), c3 (shadow), id (unique)
{%- endcomment -%}
<svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" class="gcg" role="img" aria-hidden="true">
  <defs>
    <radialGradient id="body-{{ id }}" cx="36%" cy="28%" r="78%">
      <stop offset="0%" stop-color="{{ c1 }}"/>
      <stop offset="55%" stop-color="{{ c2 }}"/>
      <stop offset="100%" stop-color="{{ c3 }}"/>
    </radialGradient>
    <linearGradient id="rim-{{ id }}" x1="0" y1="1" x2="0.4" y2="0">
      <stop offset="0%" stop-color="#ffffff" stop-opacity=".55"/>
      <stop offset="60%" stop-color="#ffffff" stop-opacity="0"/>
    </linearGradient>
    <radialGradient id="glow-{{ id }}" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="{{ c2 }}" stop-opacity=".38"/>
      <stop offset="100%" stop-color="{{ c2 }}" stop-opacity="0"/>
    </radialGradient>
  </defs>

  {%- comment -%} soft coloured glow beneath {%- endcomment -%}
  <ellipse cx="60" cy="66" rx="52" ry="50" fill="url(#glow-{{ id }})"/>
  {%- comment -%} contact shadow {%- endcomment -%}
  <ellipse cx="62" cy="103" rx="30" ry="7" fill="#191316" opacity=".16"/>

  {%- comment -%} body — slightly squashed organic squircle {%- endcomment -%}
  <path d="M60 8C86 6 113 24 115 50C117 81 97 112 65 114C36 116 8 97 6 66C4 36 32 10 60 8Z"
        fill="url(#body-{{ id }})"/>
  {%- comment -%} bottom rim bounce-light {%- endcomment -%}
  <path d="M60 8C86 6 113 24 115 50C117 81 97 112 65 114C36 116 8 97 6 66C4 36 32 10 60 8Z"
        fill="url(#rim-{{ id }})"/>
  {%- comment -%} inner depth at the base {%- endcomment -%}
  <ellipse cx="64" cy="80" rx="38" ry="26" fill="{{ c3 }}" opacity=".22"/>

  {%- comment -%} specular highlights {%- endcomment -%}
  <ellipse cx="42" cy="33" rx="19" ry="12" fill="#ffffff" opacity=".62" transform="rotate(-27 42 33)"/>
  <ellipse cx="76" cy="90" rx="10" ry="5.5" fill="#ffffff" opacity=".22" transform="rotate(-20 76 90)"/>
  <circle cx="30" cy="56" r="3.6" fill="#ffffff" opacity=".3"/>
</svg>
