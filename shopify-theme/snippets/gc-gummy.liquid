{%- comment -%}
  Soft, squishy jelly gummy — flatter and more organic than a sphere, with a
  diffuse (not marble-glossy) highlight and a hint of inner translucency.
  Params: tone (a CSS colour-token name, e.g. '--c-cherry' or '--c-mango'), id (unique)
  All colour derives from the token via color-mix() — no raw hex anywhere.
{%- endcomment -%}
{%- assign base = 'var(' | append: tone | append: ')' -%}
{%- assign light = 'color-mix(in srgb, var(' | append: tone | append: ') 52%, white)' -%}
{%- assign dark = 'color-mix(in srgb, var(' | append: tone | append: ') 74%, black)' -%}
<svg viewBox="0 0 140 100" xmlns="http://www.w3.org/2000/svg" class="gcg" role="img" aria-hidden="true">
  <defs>
    <radialGradient id="body-{{ id }}" cx="34%" cy="30%" r="82%">
      <stop offset="0%" stop-color="{{ light }}"/>
      <stop offset="54%" stop-color="{{ base }}"/>
      <stop offset="100%" stop-color="{{ dark }}"/>
    </radialGradient>
    {%- comment -%} inner glow — reads as light passing through translucent jelly {%- endcomment -%}
    <radialGradient id="inner-{{ id }}" cx="52%" cy="64%" r="60%">
      <stop offset="0%" stop-color="var(--c-surface)" stop-opacity=".24"/>
      <stop offset="70%" stop-color="var(--c-surface)" stop-opacity="0"/>
    </radialGradient>
    {%- comment -%} soft ambient ground glow, coloured by the flavour {%- endcomment -%}
    <radialGradient id="glow-{{ id }}" cx="50%" cy="55%" r="55%">
      <stop offset="0%" stop-color="{{ base }}" stop-opacity=".3"/>
      <stop offset="100%" stop-color="{{ base }}" stop-opacity="0"/>
    </radialGradient>
    {%- comment -%} diffuse specular — a soft falloff, not a crisp sphere-highlight {%- endcomment -%}
    <radialGradient id="hi-{{ id }}" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="var(--c-surface)" stop-opacity=".46"/>
      <stop offset="55%" stop-color="var(--c-surface)" stop-opacity=".1"/>
      <stop offset="100%" stop-color="var(--c-surface)" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <ellipse cx="70" cy="58" rx="60" ry="46" fill="url(#glow-{{ id }})"/>
  <ellipse cx="74" cy="92" rx="36" ry="7" fill="var(--c-ink)" opacity=".13"/>

  {%- comment -%} body — a wide, slightly lopsided blob (squashed + irregular, not a circle) {%- endcomment -%}
  <path d="M14 54C10 28 38 5 74 6C110 7 138 24 134 52C130 82 104 99 68 98C33 97 6 79 14 54Z"
        fill="url(#body-{{ id }})"/>
  <path d="M14 54C10 28 38 5 74 6C110 7 138 24 134 52C130 82 104 99 68 98C33 97 6 79 14 54Z"
        fill="url(#inner-{{ id }})"/>

  <ellipse cx="48" cy="32" rx="21" ry="12" fill="url(#hi-{{ id }})" transform="rotate(-20 48 32)"/>
  <ellipse cx="100" cy="78" rx="8" ry="4" fill="var(--c-surface)" opacity=".14" transform="rotate(-14 100 78)"/>
</svg>
