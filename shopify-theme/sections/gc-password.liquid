{%- comment -%}
  The password page — the brand's front door until launch.

  gummychums.com points at this store now, so anyone typing the domain lands
  here. It was Dawn's default: a grey geometric placeholder titled "My Store 2".

  Self-contained on purpose. The password layout loads very little, so this
  carries its own styles and depends only on gc-tokens/gc-brand, which the
  layout now pulls in. Same gradient, wordmark and voice as the homepage, so
  the first impression is the brand rather than a Shopify stock page.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  .gcp{position:relative;min-height:100svh;display:grid;place-items:center;
    padding:var(--gutter);text-align:center;overflow:hidden;
    background:
      radial-gradient(60vw 60vw at 8% 0%,   rgba(222,29,98,.30), transparent 62%),
      radial-gradient(52vw 52vw at 96% 10%, rgba(141,170,61,.26), transparent 62%),
      radial-gradient(58vw 58vw at 90% 96%, rgba(244,116,33,.30), transparent 62%),
      var(--c-bg)}
  .gcp__in{position:relative;z-index:1;max-width:var(--container);margin-inline:auto}
  .gcp__kick{display:inline-flex;align-items:center;gap:var(--sp-2);
    background:var(--c-ink);color:var(--c-surface);border-radius:var(--r-full);
    padding:var(--sp-2) var(--sp-4);margin:0 0 var(--sp-5);
    font-size:var(--fs-xs);font-weight:var(--fw-black);
    letter-spacing:var(--ls-wide);text-transform:uppercase}
  .gcp__logo{display:block;width:min(420px,78vw);height:auto;margin:0 auto var(--sp-5)}
  .gcp__h{font-size:var(--fs-3xl);font-weight:var(--fw-black);letter-spacing:var(--ls-tight);
    line-height:var(--lh-tight);color:var(--c-ink);margin:0 auto;max-width:18ch;text-wrap:balance}
  .gcp__sub{font-size:var(--fs-lg);font-weight:var(--fw-body);color:var(--c-ink-2);
    line-height:var(--lh-body);margin:var(--sp-4) auto 0;max-width:40ch}
  .gcp__form{display:flex;flex-wrap:wrap;gap:var(--sp-2);justify-content:center;
    margin:var(--sp-7) auto 0;max-width:420px}
  .gcp__input{flex:1 1 220px;font-family:inherit;font-size:var(--fs-base);
    padding:var(--sp-3) var(--sp-5);border-radius:var(--r-full);
    border:2px solid var(--c-ink);background:var(--c-surface);color:var(--c-ink)}
  .gcp__input::placeholder{color:var(--c-ink-3)}
  .gcp__input:focus-visible{outline:3px solid var(--role-focus);outline-offset:2px}
  .gcp__ok{margin:var(--sp-4) 0 0;font-weight:var(--fw-bold);color:var(--c-accent)}
  .gcp__err{margin:var(--sp-3) 0 0;font-size:var(--fs-sm);color:var(--c-accent)}
  .gcp__foot{margin:var(--sp-8) 0 0;font-size:var(--fs-xs);color:var(--c-ink-3)}
  .gcp__foot a{color:inherit}
</style>

<section class="gcp">
  <div class="gcp__in">
    {%- if s.kicker != blank -%}<p class="gcp__kick">{{ s.kicker }}</p>{%- endif -%}

    <img class="gcp__logo" src="{{ 'gc2-wordmark-purple.png' | asset_url }}"
         alt="{{ shop.name }}" width="1200" height="520" fetchpriority="high" decoding="async">

    <h1 class="gcp__h">{{ s.heading }}</h1>
    <p class="gcp__sub">{{ s.sub }}</p>

    {%- form 'customer', class: 'gcp__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="gcp-email">{{ s.placeholder }}</label>
      <input id="gcp-email" class="gcp__input" type="email" name="contact[email]"
             placeholder="{{ s.placeholder }}" autocomplete="email" required>
      <button type="submit" class="gc-btn">{{ s.cta }}</button>
      {%- if form.posted_successfully? -%}
        <p class="gcp__ok" role="status">{{ s.thanks }}</p>
      {%- elsif form.errors -%}
        <p class="gcp__err" role="alert">{{ form.errors.messages['email'] }}</p>
      {%- endif -%}
    {%- endform -%}

    <p class="gcp__foot">
      {{ s.foot }}
      <br>
      {%- comment -%} the theme's own key; it renders the owner prompt and the link together {%- endcomment -%}
      {{ 'general.password_page.admin_link_html' | t }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "GummyChums Password",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "✦ Launching 30 October" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hey, chum! You're early." },
    { "type": "textarea", "id": "sub", "label": "Sub",
      "default": "We open on the 30th. Leave your email and we'll tell you the moment the Chums are out." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "you@email.com" },
    { "type": "text", "id": "cta", "label": "Button", "default": "Tell me first" },
    { "type": "text", "id": "thanks", "label": "Success message", "default": "You're in. See you on the 30th, chum." },
    { "type": "text", "id": "foot", "label": "Footer line", "default": "Made in India · 100% vegetarian · No added sugar" }
  ]
}
{% endschema %}
