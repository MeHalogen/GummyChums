{%- comment -%}
  Compact story block for the homepage.

  The full story ran 3,238px — four phone screens, 27% of the entire page — and
  made reaching the footer a chore. This keeps the hook (the founding question
  and why the name) and sends people to /pages/story for the rest.

  Keeps id="gc-story" so any older anchor links still land somewhere sensible.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>

  .gcts{position:relative;overflow:hidden;background:var(--role-quiet-bg);color:var(--role-quiet-ink);
    padding:clamp(var(--sp-7),5vw,var(--sp-8)) var(--gutter)}
  .gcts::before{content:"";position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(46vw 46vw at 12% 0%, var(--c-accent-soft), transparent 62%)}
  /* EDITORIAL, NOT CENTRED.
     This was text-align:center at every width below 900px, which is the shape
     every other section on the site already had. The line it carries —
     "Wellness became a checklist. We made it a treat." — is the best sentence on
     the site and it was being set like a caption. It is left-aligned and large
     now, with the kolam as a small mark beside the kicker rather than a centred
     ornament floating above it. */
  .gcts-in{position:relative;z-index:1;max-width:var(--container);margin-inline:auto}

  /* One of the Chums stands on the panel's bottom edge, so the stepped border
     below reads as ground rather than as a stray graphic. Desktop only: the
     homepage is already too tall on a phone, and this is the block that was
     just cut from four screens to half of one — it doesn't get to grow back. */
  .gcts-chum{display:none}
  @media(min-width:900px){
    .gcts{min-height:380px;display:grid;align-items:center}
    .gcts-in{padding-right:300px}

    .gcts-chum{display:block;position:absolute;right:4%;bottom:0;z-index:1;line-height:0;
      height:330px;pointer-events:none;transform-origin:50% 100%;
      animation:gctsSway 7.5s ease-in-out infinite alternate}
    .gcts-chum img{display:block;height:100%;width:auto;
      -webkit-user-drag:none;user-select:none;-webkit-touch-callout:none}
  }
  @keyframes gctsSway{from{transform:rotate(-1.2deg)}to{transform:translateY(-7px) rotate(1.2deg)}}

  /* the kolam sits above the kicker — a threshold mark at the way in */
  .gcts-kolam{display:block;margin:0 0 var(--sp-4)}
  .gcts-kolam .gc2-kolam{width:clamp(44px,7vw,64px);height:auto}

  .gcts-kick{font-weight:var(--fw-black);letter-spacing:var(--ls-wide);text-transform:uppercase;
    font-size:var(--fs-xs);color:var(--c-accent);margin:0}
  .gcts h2{font-size:var(--fs-3xl);font-weight:var(--fw-black);
    letter-spacing:var(--ls-tight);line-height:.98;margin:var(--sp-3) 0 0;max-width:19ch;
    color:var(--role-quiet-ink);text-wrap:balance}
  .gcts h2 em{font-style:normal;color:var(--c-accent)}
  .gcts-body{font-size:var(--fs-base);font-weight:var(--fw-body);color:var(--role-ink-muted);
    line-height:var(--lh-body);margin:var(--sp-5) 0 0;max-width:46ch}

  .gcts-cta{display:inline-flex;align-items:center;gap:var(--sp-2);margin-top:var(--sp-6);
    font-family:inherit;font-weight:var(--fw-black);font-size:var(--fs-base);text-decoration:none;
    color:var(--role-quiet-ink);padding:var(--sp-3) var(--sp-6);border-radius:var(--r-full);
    box-shadow:inset 0 0 0 2px var(--role-quiet-ink);
    transition:background var(--dur-2) var(--ease),color var(--dur-2) var(--ease)}
  .gcts-cta:hover{background:var(--role-quiet-ink);color:var(--role-quiet-bg)}
  .gcts-cta span{transition:transform var(--dur-2) var(--ease);display:inline-block}
  .gcts-cta:hover span{transform:translateX(4px)}

  @media (prefers-reduced-motion:reduce){.gcts-cta,.gcts-cta span{transition:none}}
  @media (prefers-reduced-motion:reduce){.gcts-chum{animation:none}}
</style>

<section class="gcts" id="gc-story">
  <div class="gcts-in gc-rise">
    {%- assign kolam_id = 'story' -%}
    <div class="gcts-kolam">{% render 'gc2-kolam', id: kolam_id, tone: '--c-purple', size: 108 %}</div>
    <p class="gcts-kick">{{ s.kicker }}</p>
    <h2>{{ s.headline | replace: '[', '<em>' | replace: ']', '</em>' }}</h2>
    <p class="gcts-body">{{ s.body }}</p>
    <a class="gcts-cta" href="{{ s.link }}">{{ s.cta }} <span>→</span></a>
  </div>
  <div class="gcts-chum" aria-hidden="true">
    <img src="{{ 'gc3-tara-sit.webp' | asset_url }}" alt="" width="554" height="760" loading="lazy" decoding="async" draggable="false">
  </div>
</section>

{% schema %}
{
  "name": "GummyChums Story Teaser",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why we exist" },
    { "type": "textarea", "id": "headline", "label": "Headline (use [ ] for pink)",
      "default": "Wellness became a [checklist]. We made it a treat." },
    { "type": "textarea", "id": "body", "label": "Body",
      "default": "A chum is the friend who reminded you, shared their lunch, called after a bad day — and never made it feel like work. That’s the job we gave ourselves." },
    { "type": "text", "id": "cta", "label": "CTA label", "default": "Read our story" },
    { "type": "text", "id": "link", "label": "CTA link", "info": "Type \"url\" is not used here because Shopify rejects a default on url settings.", "default": "/pages/story" }
  ],
  "presets": [{ "name": "GummyChums Story Teaser" }]
}
{% endschema %}
