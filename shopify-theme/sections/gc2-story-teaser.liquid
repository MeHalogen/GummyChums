{%- comment -%}
  Compact story block for the homepage.

  The full story ran 3,238px — four phone screens, 27% of the entire page — and
  made reaching the footer a chore. This keeps the hook (the founding question
  and why the name) and sends people to /pages/story for the rest.

  Keeps id="gc-story" so any older anchor links still land somewhere sensible.

  A BAND, NOT A PANEL ON CREAM.
  This spent several rounds as a rounded purple rectangle floating on the cream
  with a Chum pasted beside it. Mehal, twice: the purple on cream does not look
  good and the girl sitting against it looks worse. He was right — a saturated
  block with hard edges sitting on a pale ground reads as a sticker, and
  anything placed next to it reads as a second sticker. It runs edge to edge
  now and carries the brand book's stepped border top and bottom, which is the
  treatment gc-story.liquid already uses for the same colour on the same cream.
  The Chum sits inside the colour instead of against it.
{%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  .gcts{position:relative;overflow:hidden;background:var(--c-purple);color:var(--c-purple-ink);
    padding:clamp(var(--sp-8),6vw,var(--sp-9)) var(--gutter)}
  .gcts::before{content:"";position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(54vw 54vw at 88% 110%, var(--c-accent-soft), transparent 64%)}

  /* the stepped border sits flush against the band, peaks biting into the cream */
  .gcts-edge{line-height:0;background:transparent}
  .gcts-edge--in{margin-bottom:-1px}
  .gcts-edge--out{margin-top:-1px}

  .gcts-in{position:relative;z-index:1;max-width:var(--container);margin-inline:auto}
  @media(min-width:900px){
    .gcts-in{display:grid;grid-template-columns:minmax(0,1fr) clamp(230px,23vw,300px);
      gap:clamp(var(--sp-6),5vw,var(--sp-8));align-items:end}
  }

  /* the kolam sits above the kicker — a threshold mark at the way in */
  .gcts-kolam{display:block;margin:0 0 var(--sp-4)}
  .gcts-kolam .gc2-kolam{width:clamp(44px,7vw,64px);height:auto}

  .gcts-kick{font-weight:var(--fw-black);letter-spacing:var(--ls-wide);text-transform:uppercase;
    font-size:var(--fs-xs);color:var(--gc-cherry-soft);margin:0}
  .gcts h2{font-size:var(--fs-3xl);font-weight:var(--fw-black);
    letter-spacing:var(--ls-tight);line-height:.98;margin:var(--sp-3) 0 0;max-width:19ch;
    color:var(--c-purple-ink);text-wrap:balance}
  .gcts h2 em{font-style:normal;color:var(--c-accent)}
  .gcts-body{font-size:var(--fs-base);font-weight:var(--fw-body);
    color:color-mix(in srgb, var(--c-purple-ink) 84%, transparent);
    line-height:var(--lh-body);margin:var(--sp-5) 0 0;max-width:46ch}

  .gcts-cta{display:inline-flex;align-items:center;gap:var(--sp-2);margin-top:var(--sp-6);
    font-family:inherit;font-weight:var(--fw-black);font-size:var(--fs-base);text-decoration:none;
    color:var(--c-purple-ink);padding:var(--sp-3) var(--sp-6);border-radius:var(--r-full);
    box-shadow:inset 0 0 0 2px var(--c-purple-ink);
    transition:background var(--dur-2) var(--ease),color var(--dur-2) var(--ease)}
  .gcts-cta:hover{background:var(--c-purple-ink);color:var(--c-purple)}
  .gcts-cta:focus-visible{outline:3px solid var(--role-focus);outline-offset:3px}
  .gcts-cta span{transition:transform var(--dur-2) var(--ease);display:inline-block}
  .gcts-cta:hover span{transform:translateX(4px)}

  /* Desktop only: the homepage is already tall on a phone, and this is the
     block that was cut from four screens to half of one. It does not grow back. */
  .gcts-chum{display:none}
  @media(min-width:900px){
    .gcts-chum{display:block;justify-self:end;line-height:0;pointer-events:none;
      /* -padding so she sits on the band's floor rather than above it */
      margin-bottom:calc(clamp(var(--sp-8),6vw,var(--sp-9)) * -1);
      transform-origin:50% 100%;
      animation:gctsSway 7.5s ease-in-out infinite alternate}
    .gcts-chum img{display:block;width:100%;height:auto;
      -webkit-user-drag:none;user-select:none;-webkit-touch-callout:none}
  }
  @keyframes gctsSway{from{transform:rotate(-1.2deg)}to{transform:translateY(-7px) rotate(1.2deg)}}

  @media (prefers-reduced-motion:reduce){.gcts-cta,.gcts-cta span,.gcts-chum{transition:none;animation:none}}
</style>

{%- comment -%} pre-assigned ids: {% render %} does not evaluate filters {%- endcomment -%}
{%- assign edge_top = 'teaser-top' -%}
{%- assign edge_bot = 'teaser-bot' -%}
{%- assign kolam_id = 'story' -%}

<div class="gcts-edge gcts-edge--in">{% render 'gc2-edge', id: edge_top, tone: '--c-purple', side: 'bottom' %}</div>
<section class="gcts" id="gc-story">
  <div class="gcts-in gc-rise">
    <div>
      <div class="gcts-kolam">{% render 'gc2-kolam', id: kolam_id, tone: '--c-purple-ink', size: 108 %}</div>
      <p class="gcts-kick">{{ s.kicker }}</p>
      <h2>{{ s.headline | replace: '[', '<em>' | replace: ']', '</em>' }}</h2>
      <p class="gcts-body">{{ s.body }}</p>
      <a class="gcts-cta" href="{{ s.link }}">{{ s.cta }} <span>&rarr;</span></a>
    </div>
    <div class="gcts-chum" aria-hidden="true">
      <img src="{{ 'gc3-tara-sit.webp' | asset_url }}" alt="" width="554" height="760" loading="lazy" decoding="async" draggable="false">
    </div>
  </div>
</section>
<div class="gcts-edge gcts-edge--out">{% render 'gc2-edge', id: edge_bot, tone: '--c-purple', side: 'top' %}</div>

{% schema %}
{
  "name": "GummyChums Story Teaser",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "✦ Why we exist" },
    { "type": "textarea", "id": "headline", "label": "Headline (use [ ] for pink)",
      "default": "Wellness became a [checklist]. We made it a treat." },
    { "type": "textarea", "id": "body", "label": "Body",
      "default": "A chum is the friend who reminded you, shared their lunch, called after a bad day — and never made it feel like work. That’s the job we gave ourselves." },
    { "type": "text", "id": "cta", "label": "CTA label", "default": "Read our story" },
    { "type": "text", "id": "link", "label": "CTA link", "info": "Type \"url\" is not used here because Shopify rejects a default on url settings.", "default": "/pages/story" }
  ],
  "presets": [{ "name": "GummyChums Story Teaser" }]
}
{% endschema %}
