{%- comment -%} GummyChums product page — brand design, real variants + cart {%- endcomment -%}
{%- assign GPATH = 'M50 3C72 1 95 18 97 42C99 68 82 95 55 97C30 99 5 82 3 55C1 30 26 5 50 3Z' -%}
{%- assign t = product.title | downcase -%}
{%- if t contains 'melatonin' or t contains 'sleep' -%}
  {%- assign pc_var = '--c-cherry' -%}{%- assign pc_soft_var = '--c-cherry-soft' -%}
  {%- assign pc_deep_var = '--c-cherry' -%}
  {%- assign chum_img = 'gc3-tara-stand.webp' -%}{%- assign chum_alt = 'Tara, the Sleep Chum, with an iced coffee' -%}
  {%- assign chum_sit = 'gc3-tara-sit.webp' -%}
  {%- assign chum_name = 'Tara' -%}{%- assign chum_title = 'Sleep Chum' -%}
  {%- assign chum_story = 'Inspired by the stars, Tara is your bedtime Chum, here to bring a little calm to your wind-down routine.' -%}
  {%- assign role = 'Sleep' -%}{%- assign flavour = 'Cherry' -%}{%- assign line = 'Sleep tight, Chum.' -%}
{%- elsif t contains 'eye' -%}
  {%- assign pc_var = '--c-orange' -%}{%- assign pc_soft_var = '--c-orange-soft' -%}
  {%- assign pc_deep_var = '--c-orange-deep' -%}
  {%- assign chum_img = 'gc3-nain-stand.webp' -%}{%- assign chum_alt = 'Nain, the Eye Care Chum, with his backpack' -%}
  {%- assign chum_sit = 'gc3-nain-sit.webp' -%}
  {%- assign chum_name = 'Nain' -%}{%- assign chum_title = 'Eye Care Chum' -%}
  {%- assign chum_story = 'Nain means ‘eyes’. Nain represents the way we see and experience the world, with a focus on everyday eye health.' -%}
  {%- assign role = 'Eye care' -%}{%- assign flavour = 'Orange' -%}{%- assign line = 'Screen-tired eyes? New bestie.' -%}
{%- else -%}
  {%- assign pc_var = '--c-mango' -%}{%- assign pc_soft_var = '--c-mango-soft' -%}
  {%- assign pc_deep_var = '--c-mango-deep' -%}
  {%- assign chum_img = 'gc3-dhi-peace.webp' -%}{%- assign chum_alt = 'Dhi, the Focus Chum, throwing a peace sign' -%}
  {%- assign chum_sit = 'gc3-dhi-sit.webp' -%}
  {%- assign chum_name = 'Dhi' -%}{%- assign chum_title = 'Focus Chum' -%}
  {%- assign chum_story = 'Dhi is associated with intellect and wisdom. Dhi represents curiosity, clear thinking and a love for learning.' -%}
  {%- assign role = 'Focus' -%}{%- assign flavour = 'Mango' -%}{%- assign line = 'Big brain energy, tiny gummy.' -%}
{%- endif -%}

{{ 'section-gc-product.css' | asset_url | stylesheet_tag }}

<div class="gp" style="--pc:var({{ pc_var }});--pc-soft:var({{ pc_soft_var }});--pc-deep:var({{ pc_deep_var }})">
  <p class="gp-crumb"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.all_products_collection_url }}">Shop</a> / {{ product.title }}</p>

  <div class="gp-top">
    <!-- media -->
    <div class="gp-media gc-rise in">
      <span class="gp-badge">{{ role }} · {{ flavour }}</span>
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 1100 | image_tag: width: 1100, height: 1100, alt: product.title, class: 'gp-photo' }}
      {%- else -%}
        {%- comment -%}
          Until there are photographs, this is the brand's own composition — the
          same gummy cluster and Chum the homepage cards use, at the size the
          money page deserves. It replaced a single flat blob on a washed tint,
          which read as a missing image rather than as a product, and which left
          the characters — the whole identity — off the page that sells.
        {%- endcomment -%}
        {%- assign ga = 'pdp-a' -%}{%- assign gb = 'pdp-b' -%}{%- assign gc = 'pdp-c' -%}
        <span class="gp-cluster" aria-hidden="true">
          <span class="gp-g gp-g1">{% render 'gc-gummy', tone: pc_var, id: ga %}</span>
          <span class="gp-g gp-g2">{% render 'gc-gummy', tone: pc_var, id: gb %}</span>
          <span class="gp-g gp-g3">{% render 'gc-gummy', tone: pc_var, id: gc %}</span>
        </span>
        <img class="gp-fig" src="{{ chum_img | asset_url }}" alt="{{ chum_alt }}"
             width="406" height="760" decoding="async" draggable="false">
      {%- endif -%}
    </div>

    <!-- info -->
    <div>
      <p class="gp-kick">{{ role }} ✦ {{ flavour }} flavour</p>
      <h1 class="gp-title">{{ product.title }}</h1>
      <p class="gp-line">{{ line }}</p>

      <div class="gp-price">
        <b>{% render 'gc-money', price: product.selected_or_first_available_variant.price %}</b>
        {%- if product.compare_at_price > product.price -%}<s>{% render 'gc-money', price: product.compare_at_price %}</s>{%- endif -%}
      </div>
      <p class="gp-tax">Inclusive of all taxes · 30 gummies · Net 105 g</p>
      <p class="gp-age">For adults 18+ · Not for medicinal use</p>

      <div class="gp-facts">
        <span class="gp-fact gc-mark">100% Veg</span>
        <span class="gp-fact gc-mark">No Added Sugar</span>
        <span class="gp-fact gc-mark">Made in India</span>
      </div>

      <form method="post" action="{{ routes.cart_add_url }}" class="gp-form" id="gp-form">
        {%- if product.variants.size > 1 -%}
          <div class="gp-variants" id="gp-vars">
            {%- for v in product.variants -%}
              <button type="button" class="gp-var" data-vid="{{ v.id }}"
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ v.title }}</button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <input type="hidden" name="id" id="gp-vid" value="{{ product.selected_or_first_available_variant.id }}">

        <div class="gp-qty">
          <button type="button" id="gp-minus" aria-label="Decrease">−</button>
          <span id="gp-qtyv">1</span>
          <button type="button" id="gp-plus" aria-label="Increase">+</button>
        </div>
        <input type="hidden" name="quantity" id="gp-qty" value="1">

        {%- if product.available -%}
          <button type="submit" class="gp-buy" id="gp-buy">Add to bag · {% render 'gc-money', price: product.selected_or_first_available_variant.price %}</button>
          <button type="button" class="gp-now" id="gp-now">Buy it now</button>
          {%- comment -%}
            Not "Easy returns" any more. Returns are 48 hours, sealed pack
            only, and require an uncut unboxing video — calling that easy sets
            up a customer to discover the real terms at the worst moment. The
            link goes to the policy so the terms are one tap away.
          {%- endcomment -%}
          <p class="gp-note">Ships in 3–10 days ·
            {%- if shop.refund_policy != blank -%}
              <a href="{{ shop.refund_policy.url }}">48-hour returns</a>
            {%- else -%}
              48-hour returns
            {%- endif -%}
          </p>
        {%- else -%}
          <button type="button" class="gp-buy" disabled>Sold out</button>
        {%- endif -%}
      </form>
      <p class="gp-added" id="gp-added" hidden>In your bag ✓ <a href="{{ routes.cart_url }}" id="gp-viewbag">View bag →</a></p>

      {%- comment -%}
        Payment methods are deliberately NOT listed. Nothing on the storefront
        should name a method until it is confirmed enabled at checkout — see
        docs/NOTES-TO-PRIYAL.md. Restore this block once Priyal confirms.
      {%- endcomment -%}
      <div class="gp-pay">
        <span class="gc-eyebrow gp-pay-t">Secure checkout</span>
      </div>

      {%- comment -%}
        Delivery check. The question every Indian shopper asks before they trust
        a new D2C site — "does it even come to me?" — answered in place instead
        of buried in a policy page.

        The lookup ships WITH the theme: a prefix table, no API call. That means
        no key to leak, no third party to go down, no round trip, and the PIN
        never leaves the browser. Three-digit prefixes name the big cities, two
        digits cover the state, and anything unrecognised still gets an honest
        pan-India answer rather than a dead end.
      {%- endcomment -%}
      <div class="gp-pin">
        <label class="gp-pin-t" for="gp-pin-in">Check delivery to your PIN code</label>
        <div class="gp-pin-row">
          <input class="gp-pin-in" id="gp-pin-in" type="text" inputmode="numeric"
                 pattern="[0-9]*" maxlength="6" placeholder="e.g. 302001"
                 autocomplete="postal-code" aria-describedby="gp-pin-out">
          <button class="gp-pin-go" type="button" id="gp-pin-go">Check</button>
        </div>
        <p class="gp-pin-out" id="gp-pin-out" role="status" aria-live="polite"></p>
      </div>

      {%- comment -%} share — Gen Z sends the link before they buy {%- endcomment -%}
      <div class="gp-share">
        <span class="gp-share-t">Send to a chum</span>
        <a class="gp-share-b" id="gp-wa" href="#" target="_blank" rel="noopener">WhatsApp</a>
        <button type="button" class="gp-share-b" id="gp-copy">Copy link</button>
      </div>

      {%- comment -%}
        The characters finally get names and stories on the page that sells them.
        Each Chum's name carries the product's meaning — Dhi is intellect, Tara is
        the stars, Nain is eyes — and until now the site showed the drawings and
        said none of it.
      {%- endcomment -%}
      <div class="gp-chum">
        <img class="gp-chum__fig" src="{{ chum_sit | asset_url }}" alt="{{ chum_name }}, the {{ chum_title }}"
             width="554" height="760" loading="lazy" decoding="async" draggable="false">
        <div class="gp-chum__copy">
          <p class="gp-chum__kick">Meet your Chum</p>
          <h2 class="gp-chum__name">{{ chum_name }}</h2>
          <p class="gp-chum__role">{{ chum_title }}</p>
          <p class="gp-chum__story">{{ chum_story }}</p>
        </div>
      </div>

      <div class="gp-acc">
        <details open><summary>What’s inside</summary>
          <div class="body gp-rte">
            {%- if product.description != blank -%}{{ product.description }}{%- endif -%}
            {% render 'gc-product-facts', product: product %}
          </div>
        </details>
        <details><summary>How to take it</summary>
          <div class="body">One gummy a day, whenever suits you. No water, no pills, no fuss — your daily chum is waiting.</div>
        </details>
        <details><summary>Shipping &amp; returns</summary>
          <div class="body">We ship pan-India via Shiprocket, usually delivered in 3–10 working days with tracking. Returns are accepted within 48 hours of delivery, on an unopened pack, and we need an uncut unboxing video — the full rules are in our Returns policy.</div>
        </details>
      </div>
    </div>
  </div>

  {%- comment -%}
    Sticky mobile buy bar. Submits the SAME form as the main button (form=
    attribute), so quantity + variant selection stay in one place.
  {%- endcomment -%}
  {%- if product.available -%}
    <div class="gp-sticky" id="gp-sticky" aria-hidden="true">
      <div class="gp-sticky-in">
        <span class="gp-sticky-info">
          <b>{{ product.title }}</b>
          <span>{% render 'gc-money', price: product.selected_or_first_available_variant.price %}</span>
        </span>
        <button type="submit" form="gp-form" class="gp-sticky-buy">Add to bag</button>
      </div>
    </div>
  {%- endif -%}

  <!-- other flavours -->
  <div class="gp-more">
    <h2>Meet the other chums</h2>
    <div class="gp-grid">
      {%- for p in collections.all.products -%}
        {%- unless p.id == product.id -%}
          {%- assign pt = p.title | downcase -%}
          {%- if pt contains 'melatonin' or pt contains 'sleep' -%}{%- assign mpc_var = '--c-cherry' -%}{%- assign mpc_soft_var = '--c-cherry-soft' -%}
          {%- elsif pt contains 'eye' -%}{%- assign mpc_var = '--c-orange' -%}{%- assign mpc_soft_var = '--c-orange-soft' -%}
          {%- else -%}{%- assign mpc_var = '--c-mango' -%}{%- assign mpc_soft_var = '--c-mango-soft' -%}{%- endif -%}
          <a class="gp-mini" href="{{ p.url }}">
            <span class="sh" style="--mpc-soft:var({{ mpc_soft_var }})">
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', width: 200, height: 200, alt: p.title }}
              {%- else -%}
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="{{ GPATH }}" style="fill:var({{ mpc_var }})"/>
                  <ellipse cx="35" cy="27" rx="16" ry="10" style="fill:var(--c-surface)" opacity=".5" transform="rotate(-25 35 27)"/>
                </svg>
              {%- endif -%}
            </span>
            <span><b>{{ p.title }}</b><span>{% render 'gc-money', price: p.price %}</span></span>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function(){
  var q=1,qv=document.getElementById('gp-qtyv'),qi=document.getElementById('gp-qty');
  var minus=document.getElementById('gp-minus'),plus=document.getElementById('gp-plus');
  function set(n){q=Math.max(1,Math.min(20,n));qv.textContent=q;qi.value=q;}
  if(minus)minus.addEventListener('click',function(){set(q-1);});
  if(plus)plus.addEventListener('click',function(){set(q+1);});
  var vars=document.getElementById('gp-vars');
  if(vars){vars.addEventListener('click',function(e){
    var b=e.target.closest('.gp-var'); if(!b)return;
    vars.querySelectorAll('.gp-var').forEach(function(x){x.setAttribute('aria-pressed','false');});
    b.setAttribute('aria-pressed','true');
    document.getElementById('gp-vid').value=b.dataset.vid;
  });}

  /* Buy it now — add to cart, then straight to checkout. Deterministic across
     gateways, unlike the dynamic checkout button (which mostly surfaces wallets
     that are not the norm for Indian shoppers). */
  var now=document.getElementById('gp-now'),form=document.getElementById('gp-form');
  if(now&&form)now.addEventListener('click',function(){
    if(now.getAttribute('aria-busy')==='true')return;
    now.setAttribute('aria-busy','true');
    var label=now.textContent; now.textContent='Taking you to checkout…';
    fetch(window.routes&&window.routes.cart_add_url?window.routes.cart_add_url:'/cart/add.js',{
      method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},
      body:JSON.stringify({id:document.getElementById('gp-vid').value,
                           quantity:parseInt(document.getElementById('gp-qty').value,10)||1})
    }).then(function(r){if(!r.ok)throw new Error('add failed');return r.json();})
      .then(function(){location.href='/checkout';})
      .catch(function(){ /* fall back to the normal add-to-cart path */
        now.removeAttribute('aria-busy'); now.textContent=label; form.submit(); });
  });

  /* Add to bag without leaving the page. The plain form POST reloaded the whole
     site and dumped you on /cart; this keeps you where you are, updates the
     header count and pre-warms /cart so opening the bag is instant. The sticky
     bar's button submits this same form, so it is covered too. Any failure
     falls back to the native submit. */
  var added=document.getElementById('gp-added');
  var warmed=false;
  function warmCart(){
    if(warmed)return; warmed=true;
    var l=document.createElement('link'); l.rel='prefetch'; l.href='/cart'; document.head.appendChild(l);
  }
  function setCount(n){
    var el=document.getElementById('gc-cart-count'); if(el)el.textContent=n;
  }
  if(form)form.addEventListener('submit',function(e){
    if(!window.fetch)return;                 /* let the browser do it the old way */
    e.preventDefault();
    var btn=document.getElementById('gp-buy');
    if(btn&&btn.getAttribute('aria-busy')==='true')return;
    var label=btn?btn.textContent:'';
    if(btn){btn.setAttribute('aria-busy','true');btn.textContent='Adding…';}
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},
      body:JSON.stringify({id:document.getElementById('gp-vid').value,
                           quantity:parseInt(document.getElementById('gp-qty').value,10)||1})})
      .then(function(r){if(!r.ok)throw new Error('add failed');return r.json();})
      .then(function(){return fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json();});})
      .then(function(cart){
        setCount(cart.item_count);
        if(btn){btn.removeAttribute('aria-busy');btn.textContent=label;}
        if(added)added.hidden=false;
        warmCart();
      })
      .catch(function(){
        if(btn){btn.removeAttribute('aria-busy');btn.textContent=label;}
        form.submit();
      });
  });

  /* sticky bar: show once the real Add button has scrolled out of view */
  var sticky=document.getElementById('gp-sticky'),buy=document.getElementById('gp-buy');
  if(sticky&&buy&&'IntersectionObserver' in window){
    new IntersectionObserver(function(en){
      var gone=!en[0].isIntersecting;
      sticky.classList.toggle('on',gone);
      sticky.setAttribute('aria-hidden',gone?'false':'true');
    },{rootMargin:'0px 0px -10% 0px'}).observe(buy);
  }

  /* share — WhatsApp is the default share channel here, not email */
  var url=location.href.split('?')[0];
  var wa=document.getElementById('gp-wa');
  if(wa)wa.href='https://wa.me/?text='+encodeURIComponent({{ product.title | json }}+' — '+url);
  var copy=document.getElementById('gp-copy');
  if(copy)copy.addEventListener('click',function(){
    var done=function(){var t=copy.textContent;copy.textContent='Copied ✓';
      setTimeout(function(){copy.textContent=t;},1600);};
    if(navigator.clipboard)navigator.clipboard.writeText(url).then(done).catch(function(){});
    else done();
  });
})();

  /* ---------- delivery check ----------
     Prefix table, no network call: the PIN never leaves the page, there is no
     key to leak and nothing third-party to go down. CITY covers the metros by
     three digits so the answer is specific where it can be; STATE covers the
     rest by two. Delivery bands come from the zones we actually ship on —
     anything unmatched still gets an honest pan-India answer. */
  var CITY = {
    '110':'Delhi','201':'Noida','122':'Gurugram','160':'Chandigarh','226':'Lucknow',
    '302':'Jaipur','380':'Ahmedabad','395':'Surat','400':'Mumbai','403':'Goa',
    '411':'Pune','440':'Nagpur','452':'Indore','462':'Bhopal','500':'Hyderabad',
    '560':'Bengaluru','600':'Chennai','641':'Coimbatore','682':'Kochi','695':'Thiruvananthapuram',
    '700':'Kolkata','751':'Bhubaneswar','781':'Guwahati','800':'Patna','834':'Ranchi'
  };
  var STATE = {
    '11':'Delhi','12':'Haryana','13':'Haryana','14':'Punjab','15':'Punjab','16':'Punjab',
    '17':'Himachal Pradesh','18':'Jammu & Kashmir','19':'Jammu & Kashmir',
    '20':'Uttar Pradesh','21':'Uttar Pradesh','22':'Uttar Pradesh','23':'Uttar Pradesh',
    '24':'Uttarakhand','25':'Uttar Pradesh','26':'Uttarakhand','27':'Uttar Pradesh','28':'Uttar Pradesh',
    '30':'Rajasthan','31':'Rajasthan','32':'Rajasthan','33':'Rajasthan','34':'Rajasthan',
    '36':'Gujarat','37':'Gujarat','38':'Gujarat','39':'Gujarat',
    '40':'Maharashtra','41':'Maharashtra','42':'Maharashtra','43':'Maharashtra','44':'Maharashtra',
    '45':'Madhya Pradesh','46':'Madhya Pradesh','47':'Madhya Pradesh','48':'Madhya Pradesh','49':'Chhattisgarh',
    '50':'Telangana','51':'Andhra Pradesh','52':'Andhra Pradesh','53':'Andhra Pradesh',
    '56':'Karnataka','57':'Karnataka','58':'Karnataka','59':'Karnataka',
    '60':'Tamil Nadu','61':'Tamil Nadu','62':'Tamil Nadu','63':'Tamil Nadu','64':'Tamil Nadu',
    '67':'Kerala','68':'Kerala','69':'Kerala',
    '70':'West Bengal','71':'West Bengal','72':'West Bengal','73':'West Bengal','74':'West Bengal',
    '75':'Odisha','76':'Odisha','77':'Odisha','78':'Assam','79':'the North East',
    '80':'Bihar','81':'Bihar','82':'Bihar','83':'Jharkhand','84':'Bihar','85':'Bihar'
  };
  var SLOW = {'17':1,'18':1,'19':1,'78':1,'79':1};              /* hills, J&K, North East */
  var NEAR = {'11':1,'12':1,'13':1,'20':1,'21':1,'22':1,'23':1,'25':1,'27':1,'28':1,'30':1,'31':1,'32':1,'33':1,'34':1};

  var pinIn = document.getElementById('gp-pin-in');
  var pinGo = document.getElementById('gp-pin-go');
  var pinOut = document.getElementById('gp-pin-out');
  if (pinIn && pinGo && pinOut) {
    var check = function () {
      var v = (pinIn.value || '').replace(/\D/g, '');
      pinOut.classList.remove('is-bad');
      if (v.length !== 6) {
        pinOut.classList.add('is-bad');
        pinOut.textContent = 'That needs to be a 6-digit PIN code.';
        return;
      }
      var two = v.slice(0, 2), three = v.slice(0, 3);
      var place = CITY[three] || STATE[two];
      var days = SLOW[two] ? '7–10' : (NEAR[two] ? '3–5' : '4–7');
      /* no place name means the sentence has to start on its own */
      var lead = place ? '<b>' + place + '</b> — delivers' : 'Delivers';
      pinOut.innerHTML = lead + ' in <b>' + days +
        ' working days</b>, with tracking.';
    };
    pinGo.addEventListener('click', check);
    pinIn.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); check(); } });
    pinIn.addEventListener('input', function () {
      pinIn.value = pinIn.value.replace(/\D/g, '').slice(0, 6);
      if (pinIn.value.length === 6) check();
    });
  }
</script>

{% schema %}
{ "name": "GummyChums Product", "settings": [] }
{% endschema %}
