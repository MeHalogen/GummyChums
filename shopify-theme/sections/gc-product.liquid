{%- comment -%} GummyChums product page — brand design, real variants + cart {%- endcomment -%}
{%- assign GPATH = 'M50 3C72 1 95 18 97 42C99 68 82 95 55 97C30 99 5 82 3 55C1 30 26 5 50 3Z' -%}
{%- assign t = product.title | downcase -%}
{%- if t contains 'melatonin' or t contains 'sleep' -%}
  {%- assign pc_var = '--c-cherry' -%}{%- assign pc_soft_var = '--c-cherry-soft' -%}
  {%- assign role = 'Sleep' -%}{%- assign flavour = 'Cherry' -%}{%- assign line = 'Sleep tight, Chum.' -%}
{%- elsif t contains 'eye' -%}
  {%- assign pc_var = '--c-orange' -%}{%- assign pc_soft_var = '--c-orange-soft' -%}
  {%- assign role = 'Eye care' -%}{%- assign flavour = 'Orange' -%}{%- assign line = 'Screen-tired eyes? New bestie.' -%}
{%- else -%}
  {%- assign pc_var = '--c-mango' -%}{%- assign pc_soft_var = '--c-mango-soft' -%}
  {%- assign role = 'Focus' -%}{%- assign flavour = 'Mango' -%}{%- assign line = 'Big brain energy, tiny gummy.' -%}
{%- endif -%}

<style>
  .gp{--pc:var({{ pc_var }});--pc-soft:var({{ pc_soft_var }});max-width:var(--container);margin-inline:auto;
    padding-inline:var(--gutter);padding-top:var(--sp-7);padding-bottom:var(--sp-9)}
  .gp-crumb{font-size:var(--fs-sm);font-weight:var(--fw-bold);color:var(--c-ink-3);margin-bottom:var(--sp-5)}
  .gp-crumb a{color:inherit;text-decoration:none}.gp-crumb a:hover{color:var(--pc)}
  .gp-top{display:grid;grid-template-columns:1.05fr 1fr;gap:var(--sp-7);align-items:start}
  @media(max-width:899px){.gp-top{grid-template-columns:1fr}}

  .gp-media{position:relative;border-radius:var(--r-lg);overflow:hidden;aspect-ratio:1/1;display:grid;place-items:center;
    background:var(--pc-soft);box-shadow:var(--sh-3)}
  .gp-media img{width:100%;height:100%;object-fit:cover;position:relative;z-index:1}
  .gp-media svg{width:62%;height:auto;position:relative;z-index:1;animation:gpFloat 6s ease-in-out infinite;will-change:transform}
  @keyframes gpFloat{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-18px) rotate(3deg)}}
  @media(prefers-reduced-motion:reduce){.gp-media svg{animation:none}}
  .gp-badge{position:absolute;z-index:2;top:var(--sp-4);left:var(--sp-4);background:var(--c-surface);color:var(--pc);
    font-size:var(--fs-xs);font-weight:var(--fw-black);letter-spacing:var(--ls-wide);text-transform:uppercase;
    padding:var(--sp-2) var(--sp-4);border-radius:var(--r-full);box-shadow:var(--sh-1)}

  .gp-kick{font-weight:var(--fw-black);letter-spacing:var(--ls-wide);text-transform:uppercase;font-size:var(--fs-xs);color:var(--c-ink-3);margin:0}
  .gp-title{font-size:var(--fs-3xl);font-weight:var(--fw-black);letter-spacing:var(--ls-tight);line-height:var(--lh-tight);color:var(--c-ink);margin:var(--sp-3) 0 0}
  .gp-line{font-size:var(--fs-lg);font-weight:var(--fw-bold);color:var(--c-ink-2);margin:var(--sp-3) 0 0}
  .gp-price{display:flex;align-items:baseline;gap:var(--sp-3);margin:var(--sp-5) 0 0}
  .gp-price b{font-size:var(--fs-2xl);font-weight:var(--fw-black);color:var(--pc)}
  .gp-price s{font-size:var(--fs-base);font-weight:var(--fw-bold);color:var(--c-ink-3)}
  .gp-tax{font-size:var(--fs-sm);font-weight:var(--fw-body);color:var(--c-ink-3);margin:var(--sp-2) 0 0}

  .gp-facts{display:flex;gap:var(--sp-2);flex-wrap:wrap;margin:var(--sp-5) 0 0}
  .gp-fact{background:var(--c-surface);color:var(--c-ink);border-radius:var(--r-full);padding:var(--sp-2) var(--sp-4);
    font-size:var(--fs-sm);font-weight:var(--fw-black);box-shadow:var(--sh-1)}

  .gp-form{margin:var(--sp-5) 0 0;display:flex;flex-direction:column;gap:var(--sp-3)}
  .gp-variants{display:flex;gap:var(--sp-2);flex-wrap:wrap}
  .gp-var{border:0;cursor:pointer;font-family:inherit;font-weight:var(--fw-black);font-size:var(--fs-sm);
    padding:var(--sp-3) var(--sp-4);border-radius:var(--r-full);background:var(--c-surface);color:var(--c-ink);
    box-shadow:inset 0 0 0 2px var(--c-line);transition:box-shadow var(--dur-1) var(--ease),transform var(--dur-1) var(--ease),background var(--dur-1) var(--ease),color var(--dur-1) var(--ease)}
  .gp-var[aria-pressed="true"]{background:var(--c-ink);color:var(--c-surface);box-shadow:none}
  .gp-var:active{transform:scale(.95)}
  .gp-qty{display:flex;align-items:center;gap:var(--sp-3);background:var(--c-surface);border-radius:var(--r-full);
    padding:var(--sp-2) var(--sp-4);align-self:flex-start;box-shadow:var(--sh-1)}
  .gp-qty button{border:0;background:transparent;cursor:pointer;font-size:var(--fs-lg);font-weight:var(--fw-black);color:var(--c-ink);
    line-height:1;padding:var(--sp-1) var(--sp-2);font-family:inherit}
  .gp-qty span{font-weight:var(--fw-black);min-width:22px;text-align:center;color:var(--c-ink)}
  .gp-buy{background:var(--c-accent);color:var(--c-accent-ink);border:0;cursor:pointer;font-family:inherit;
    font-weight:var(--fw-black);font-size:var(--fs-base);padding:var(--sp-4) var(--sp-6);border-radius:var(--r-full);
    transition:transform var(--dur-1) var(--spring),background var(--dur-1) var(--ease),box-shadow var(--dur-1) var(--ease);
    box-shadow:var(--sh-2)}
  .gp-buy:hover{background:var(--c-accent-hover);transform:translateY(-2px);box-shadow:var(--sh-3)} .gp-buy:active{transform:scale(.96)}
  .gp-buy[disabled]{background:var(--c-ink-3);color:var(--c-surface);box-shadow:none;cursor:default}
  .gp-added{margin:var(--sp-3) 0 0;font-size:var(--fs-sm);font-weight:var(--fw-black);color:var(--c-ink)}
  .gp-added a{color:var(--c-accent);text-decoration:underline;text-underline-offset:3px}
  /* secondary express path — ghost, so it never competes with Add to bag */
  .gp-now{background:transparent;color:var(--c-ink);border:0;cursor:pointer;font-family:inherit;
    font-weight:var(--fw-black);font-size:var(--fs-base);padding:var(--sp-4) var(--sp-6);
    border-radius:var(--r-full);box-shadow:inset 0 0 0 2px var(--c-ink);
    transition:background var(--dur-2) var(--ease),color var(--dur-2) var(--ease),transform var(--dur-1) var(--spring)}
  .gp-now:hover{background:var(--c-ink);color:var(--c-surface)}
  .gp-now:active{transform:scale(.96)}
  .gp-now[aria-busy="true"]{opacity:.6;cursor:default}
  .gp-note{font-size:var(--fs-sm);font-weight:var(--fw-body);color:var(--c-ink-3);text-align:center}
  .gp-note a{color:var(--c-ink-2);font-weight:var(--fw-bold);text-decoration:underline;text-underline-offset:2px}
  .gp-note a:hover{color:var(--pc)}

  .gp-acc{margin:var(--sp-6) 0 0}
  .gp-acc details{background:var(--c-surface);border-radius:var(--r-md);margin-bottom:var(--sp-3);overflow:hidden;box-shadow:var(--sh-1)}
  .gp-acc summary{cursor:pointer;list-style:none;padding:var(--sp-4) var(--sp-5);font-weight:var(--fw-black);font-size:var(--fs-base);
    color:var(--c-ink);display:flex;justify-content:space-between;align-items:center;gap:var(--sp-3)}
  .gp-acc summary::-webkit-details-marker{display:none}
  .gp-acc summary::after{content:"+";font-size:var(--fs-lg);color:var(--c-ink-2);transition:transform var(--dur-3) var(--ease);line-height:1}
  .gp-acc details[open] summary::after{transform:rotate(45deg)}
  .gp-acc .body{padding:0 var(--sp-5) var(--sp-4);font-weight:var(--fw-body);font-size:var(--fs-sm);color:var(--c-ink-2);line-height:var(--lh-body)}

  /* per-day value anchor — ₹399/30 reframes the price as a daily habit cost */
  .gp-perday{font-size:var(--fs-sm);font-weight:var(--fw-bold);color:var(--c-ink-3);white-space:nowrap}

  /* rich text from the Shopify description — real paragraphs, not a stripped blob */
  .gp-rte p{margin:0 0 var(--sp-3)}
  .gp-rte p:last-child{margin-bottom:0}
  .gp-rte b{color:var(--c-ink);font-weight:var(--fw-black)}
  .gp-rte i{color:var(--c-ink-3);font-size:var(--fs-xs);display:block;margin-top:var(--sp-3);line-height:var(--lh-body)}

  /* payment reassurance */
  .gp-pay{margin:var(--sp-5) 0 0}
  .gp-pay-t{display:block;font-size:var(--fs-xs);font-weight:var(--fw-black);letter-spacing:var(--ls-wide);
    text-transform:uppercase;color:var(--c-ink-3);margin-bottom:var(--sp-3)}
  .gp-pay-row{display:flex;flex-wrap:wrap;gap:var(--sp-2)}
  .gp-chip{background:var(--c-surface);color:var(--c-ink-2);border-radius:var(--r-sm);
    padding:var(--sp-2) var(--sp-3);font-size:var(--fs-xs);font-weight:var(--fw-black);
    letter-spacing:var(--ls-normal);box-shadow:inset 0 0 0 1px var(--c-line)}
  .gp-chip--cod{color:var(--pc);box-shadow:inset 0 0 0 1.5px var(--pc)}

  /* share row */
  .gp-pin{margin:var(--sp-5) 0 0;background:var(--c-surface);border-radius:var(--r-md);
    padding:var(--sp-4) var(--sp-5) var(--sp-5);box-shadow:var(--sh-1)}
  .gp-pin-t{display:block;font-size:var(--fs-xs);font-weight:var(--fw-black);
    letter-spacing:var(--ls-wide);text-transform:uppercase;color:var(--c-ink-3);margin-bottom:var(--sp-3)}
  .gp-pin-row{display:flex;gap:var(--sp-2);flex-wrap:wrap}
  .gp-pin-in{flex:1 1 150px;min-width:0;font-family:inherit;font-size:var(--fs-base);
    font-weight:var(--fw-bold);letter-spacing:var(--ls-wide);color:var(--c-ink);
    background:var(--c-bg);border:1.5px solid var(--c-line);border-radius:var(--r-sm);
    padding:var(--sp-3) var(--sp-4);outline:none;transition:border-color var(--dur-2) var(--ease)}
  .gp-pin-in:focus{border-color:var(--pc)}
  .gp-pin-in::placeholder{color:var(--c-ink-3);font-weight:var(--fw-body);letter-spacing:var(--ls-normal)}
  .gp-pin-go{border:0;cursor:pointer;font-family:inherit;font-weight:var(--fw-black);
    font-size:var(--fs-sm);color:var(--c-surface);background:var(--pc);
    padding:var(--sp-3) var(--sp-6);border-radius:var(--r-sm);
    transition:filter var(--dur-2) var(--ease),transform var(--dur-1) var(--spring)}
  .gp-pin-go:hover{filter:brightness(1.08)}
  .gp-pin-go:active{transform:scale(.96)}
  /* qualified past Dawn's `p:empty{display:none}`: this starts empty on purpose
     and its min-height reserves the space the answer will occupy */
  .gp-pin .gp-pin-out{display:block;margin:var(--sp-3) 0 0;font-size:var(--fs-sm);font-weight:var(--fw-body);
    color:var(--c-ink-2);line-height:var(--lh-body);min-height:1.2em}
  .gp-pin-out b{color:var(--c-ink);font-weight:var(--fw-black)}
  .gp-pin-out.is-bad{color:var(--c-accent)}
  @media (prefers-reduced-motion:reduce){.gp-pin-go{transition:none}}

  .gp-share{margin:var(--sp-5) 0 0;display:flex;align-items:center;gap:var(--sp-3);flex-wrap:wrap}
  .gp-share-t{font-size:var(--fs-xs);font-weight:var(--fw-black);letter-spacing:var(--ls-wide);
    text-transform:uppercase;color:var(--c-ink-3)}
  .gp-share-b{border:0;cursor:pointer;font-family:inherit;background:var(--c-surface);color:var(--c-ink);
    text-decoration:none;font-size:var(--fs-sm);font-weight:var(--fw-black);padding:var(--sp-2) var(--sp-4);
    border-radius:var(--r-full);box-shadow:inset 0 0 0 1px var(--c-line);
    transition:box-shadow var(--dur-1) var(--ease),color var(--dur-1) var(--ease)}
  .gp-share-b:hover{color:var(--pc);box-shadow:inset 0 0 0 1.5px var(--pc)}

  /* sticky mobile buy bar — the single biggest mobile conversion lever */
  .gp-sticky{position:fixed;left:0;right:0;bottom:0;z-index:70;display:none;
    background:var(--c-surface);border-top:1px solid var(--c-line);
    padding:var(--sp-3) var(--gutter);padding-bottom:calc(var(--sp-3) + env(safe-area-inset-bottom));
    box-shadow:var(--sh-3);transform:translateY(110%);transition:transform var(--dur-3) var(--ease)}
  .gp-sticky.on{transform:translateY(0)}
  .gp-sticky-in{max-width:var(--container);margin-inline:auto;display:flex;align-items:center;
    justify-content:space-between;gap:var(--sp-4)}
  .gp-sticky-info{display:flex;flex-direction:column;min-width:0}
  .gp-sticky-info b{font-size:var(--fs-sm);font-weight:var(--fw-black);color:var(--c-ink);
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .gp-sticky-info span{font-size:var(--fs-base);font-weight:var(--fw-black);color:var(--pc)}
  .gp-sticky-buy{flex:0 0 auto;border:0;cursor:pointer;font-family:inherit;background:var(--c-accent);
    color:var(--c-accent-ink);font-weight:var(--fw-black);font-size:var(--fs-sm);
    padding:var(--sp-4) var(--sp-6);border-radius:var(--r-full);
    transition:transform var(--dur-1) var(--spring)}
  .gp-sticky-buy:active{transform:scale(.96)}
  @media(max-width:899px){.gp-sticky{display:block}}
  @media(max-width:899px){.gp{padding-bottom:var(--sp-10)}}
  /* lift the floating WhatsApp button clear of the sticky bar — product page only */
  @media(max-width:899px){.gc-wa{bottom:92px}}
  @media (prefers-reduced-motion:reduce){.gp-sticky{transition:none}}

  .gp-more{margin-top:var(--sp-9)}
  .gp-more h2{font-size:var(--fs-2xl);font-weight:var(--fw-black);letter-spacing:var(--ls-tight);text-align:center;color:var(--c-ink);margin:0 0 var(--sp-5)}
  .gp-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sp-4);max-width:760px;margin:0 auto}
  @media(max-width:749px){.gp-grid{grid-template-columns:1fr}}
  .gp-mini{background:var(--c-surface);border-radius:var(--r-md);padding:var(--sp-4);display:flex;align-items:center;gap:var(--sp-4);
    text-decoration:none;color:var(--c-ink);box-shadow:var(--sh-2);transition:transform var(--dur-2) var(--spring),box-shadow var(--dur-2) var(--ease)}
  .gp-mini:hover{transform:translateY(-5px);box-shadow:var(--sh-3)}
  .gp-mini .sh{width:78px;height:78px;flex:0 0 auto;border-radius:var(--r-sm);display:grid;place-items:center;overflow:hidden;background:var(--mpc-soft)}
  .gp-mini .sh img{width:100%;height:100%;object-fit:cover}
  .gp-mini .sh svg{width:74%}
  .gp-mini b{display:block;font-size:var(--fs-base);font-weight:var(--fw-black)}
  .gp-mini span{font-size:var(--fs-sm);font-weight:var(--fw-bold);color:var(--c-ink-2)}
</style>

<div class="gp">
  <p class="gp-crumb"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.all_products_collection_url }}">Shop</a> / {{ product.title }}</p>

  <div class="gp-top">
    <!-- media -->
    <div class="gp-media gc-rise in">
      <span class="gp-badge">{{ role }} · {{ flavour }}</span>
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 1100 | image_tag: width: 1100, height: 1100, alt: product.title }}
      {%- else -%}
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ product.title }}">
          <path d="{{ GPATH }}" style="fill:var({{ pc_var }})"/>
          <ellipse cx="35" cy="27" rx="16" ry="10" style="fill:var(--c-surface)" opacity=".5" transform="rotate(-25 35 27)"/>
        </svg>
      {%- endif -%}
    </div>

    <!-- info -->
    <div>
      <p class="gp-kick">{{ role }} ✦ {{ flavour }} flavour</p>
      <h1 class="gp-title">{{ product.title }}</h1>
      <p class="gp-line">{{ line }}</p>

      <div class="gp-price">
        <b>{% render 'gc-money', price: product.selected_or_first_available_variant.price %}</b>
        {%- if product.compare_at_price > product.price -%}<s>{% render 'gc-money', price: product.compare_at_price %}</s>{%- endif -%}
        {%- comment -%} round to whole rupees — "₹13/day" reads better than "₹13.30/day" {%- endcomment -%}
        {%- assign per_day = product.selected_or_first_available_variant.price | divided_by: 3000 | round -%}
        <span class="gp-perday">≈ ₹{{ per_day }}/day</span>
      </div>
      <p class="gp-tax">Inclusive of all taxes · 30 gummies · Cash on Delivery available</p>

      <div class="gp-facts">
        <span class="gp-fact">🌱 100% Veg</span>
        <span class="gp-fact">🚫 No Added Sugar</span>
        <span class="gp-fact">🇮🇳 Made in India</span>
      </div>

      <form method="post" action="{{ routes.cart_add_url }}" class="gp-form" id="gp-form">
        {%- if product.variants.size > 1 -%}
          <div class="gp-variants" id="gp-vars">
            {%- for v in product.variants -%}
              <button type="button" class="gp-var" data-vid="{{ v.id }}"
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ v.title }}</button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <input type="hidden" name="id" id="gp-vid" value="{{ product.selected_or_first_available_variant.id }}">

        <div class="gp-qty">
          <button type="button" id="gp-minus" aria-label="Decrease">−</button>
          <span id="gp-qtyv">1</span>
          <button type="button" id="gp-plus" aria-label="Increase">+</button>
        </div>
        <input type="hidden" name="quantity" id="gp-qty" value="1">

        {%- if product.available -%}
          <button type="submit" class="gp-buy" id="gp-buy">Add to bag · {% render 'gc-money', price: product.selected_or_first_available_variant.price %}</button>
          <button type="button" class="gp-now" id="gp-now">Buy it now</button>
          <p class="gp-note">Ships in 3–10 days ·
            {%- if shop.refund_policy != blank -%}
              <a href="{{ shop.refund_policy.url }}">Easy returns</a>
            {%- else -%}
              Easy returns
            {%- endif -%}
          </p>
        {%- else -%}
          <button type="button" class="gp-buy" disabled>Sold out</button>
        {%- endif -%}
      </form>
      <p class="gp-added" id="gp-added" hidden>In your bag ✓ <a href="{{ routes.cart_url }}" id="gp-viewbag">View bag →</a></p>

      {%- comment -%} payment reassurance — COD/UPI are the two questions every Indian first-time buyer has {%- endcomment -%}
      <div class="gp-pay">
        <span class="gp-pay-t">Secure checkout</span>
        <div class="gp-pay-row">
          <span class="gp-chip">UPI</span>
          <span class="gp-chip">Cards</span>
          <span class="gp-chip">Net banking</span>
          <span class="gp-chip">Wallets</span>
          <span class="gp-chip gp-chip--cod">Cash on Delivery</span>
        </div>
      </div>

      {%- comment -%}
        Delivery check. The question every Indian shopper asks before they trust
        a new D2C site — "does it even come to me?" — answered in place instead
        of buried in a policy page.

        The lookup ships WITH the theme: a prefix table, no API call. That means
        no key to leak, no third party to go down, no round trip, and the PIN
        never leaves the browser. Three-digit prefixes name the big cities, two
        digits cover the state, and anything unrecognised still gets an honest
        pan-India answer rather than a dead end.
      {%- endcomment -%}
      <div class="gp-pin">
        <label class="gp-pin-t" for="gp-pin-in">Check delivery to your PIN code</label>
        <div class="gp-pin-row">
          <input class="gp-pin-in" id="gp-pin-in" type="text" inputmode="numeric"
                 pattern="[0-9]*" maxlength="6" placeholder="e.g. 302001"
                 autocomplete="postal-code" aria-describedby="gp-pin-out">
          <button class="gp-pin-go" type="button" id="gp-pin-go">Check</button>
        </div>
        <p class="gp-pin-out" id="gp-pin-out" role="status" aria-live="polite"></p>
      </div>

      {%- comment -%} share — Gen Z sends the link before they buy {%- endcomment -%}
      <div class="gp-share">
        <span class="gp-share-t">Send to a chum</span>
        <a class="gp-share-b" id="gp-wa" href="#" target="_blank" rel="noopener">WhatsApp</a>
        <button type="button" class="gp-share-b" id="gp-copy">Copy link</button>
      </div>

      <div class="gp-acc">
        <details open><summary>What’s inside</summary>
          <div class="body gp-rte">
            {%- if product.description != blank -%}{{ product.description }}
            {%- else -%}Full ingredient list coming soon.{%- endif -%}
          </div>
        </details>
        <details><summary>How to take it</summary>
          <div class="body">One gummy a day, whenever suits you. No water, no pills, no fuss — your daily chum is waiting.</div>
        </details>
        <details><summary>Shipping &amp; returns</summary>
          <div class="body">We ship pan-India via Shiprocket, usually delivered in 3–10 working days with tracking. Cash on Delivery available. See our Returns policy for details.</div>
        </details>
      </div>
    </div>
  </div>

  {%- comment -%}
    Sticky mobile buy bar. Submits the SAME form as the main button (form=
    attribute), so quantity + variant selection stay in one place.
  {%- endcomment -%}
  {%- if product.available -%}
    <div class="gp-sticky" id="gp-sticky" aria-hidden="true">
      <div class="gp-sticky-in">
        <span class="gp-sticky-info">
          <b>{{ product.title }}</b>
          <span>{% render 'gc-money', price: product.selected_or_first_available_variant.price %}</span>
        </span>
        <button type="submit" form="gp-form" class="gp-sticky-buy">Add to bag</button>
      </div>
    </div>
  {%- endif -%}

  <!-- other flavours -->
  <div class="gp-more">
    <h2>Meet the other chums</h2>
    <div class="gp-grid">
      {%- for p in collections.all.products -%}
        {%- unless p.id == product.id -%}
          {%- assign pt = p.title | downcase -%}
          {%- if pt contains 'melatonin' or pt contains 'sleep' -%}{%- assign mpc_var = '--c-cherry' -%}{%- assign mpc_soft_var = '--c-cherry-soft' -%}
          {%- elsif pt contains 'eye' -%}{%- assign mpc_var = '--c-orange' -%}{%- assign mpc_soft_var = '--c-orange-soft' -%}
          {%- else -%}{%- assign mpc_var = '--c-mango' -%}{%- assign mpc_soft_var = '--c-mango-soft' -%}{%- endif -%}
          <a class="gp-mini" href="{{ p.url }}">
            <span class="sh" style="--mpc-soft:var({{ mpc_soft_var }})">
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', width: 200, height: 200, alt: p.title }}
              {%- else -%}
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="{{ GPATH }}" style="fill:var({{ mpc_var }})"/>
                  <ellipse cx="35" cy="27" rx="16" ry="10" style="fill:var(--c-surface)" opacity=".5" transform="rotate(-25 35 27)"/>
                </svg>
              {%- endif -%}
            </span>
            <span><b>{{ p.title }}</b><span>{% render 'gc-money', price: p.price %}</span></span>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function(){
  var q=1,qv=document.getElementById('gp-qtyv'),qi=document.getElementById('gp-qty');
  var minus=document.getElementById('gp-minus'),plus=document.getElementById('gp-plus');
  function set(n){q=Math.max(1,Math.min(20,n));qv.textContent=q;qi.value=q;}
  if(minus)minus.addEventListener('click',function(){set(q-1);});
  if(plus)plus.addEventListener('click',function(){set(q+1);});
  var vars=document.getElementById('gp-vars');
  if(vars){vars.addEventListener('click',function(e){
    var b=e.target.closest('.gp-var'); if(!b)return;
    vars.querySelectorAll('.gp-var').forEach(function(x){x.setAttribute('aria-pressed','false');});
    b.setAttribute('aria-pressed','true');
    document.getElementById('gp-vid').value=b.dataset.vid;
  });}

  /* Buy it now — add to cart, then straight to checkout. Deterministic across
     gateways, unlike the dynamic checkout button (which mostly surfaces wallets
     that are not the norm for Indian UPI/COD shoppers). */
  var now=document.getElementById('gp-now'),form=document.getElementById('gp-form');
  if(now&&form)now.addEventListener('click',function(){
    if(now.getAttribute('aria-busy')==='true')return;
    now.setAttribute('aria-busy','true');
    var label=now.textContent; now.textContent='Taking you to checkout…';
    fetch(window.routes&&window.routes.cart_add_url?window.routes.cart_add_url:'/cart/add.js',{
      method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},
      body:JSON.stringify({id:document.getElementById('gp-vid').value,
                           quantity:parseInt(document.getElementById('gp-qty').value,10)||1})
    }).then(function(r){if(!r.ok)throw new Error('add failed');return r.json();})
      .then(function(){location.href='/checkout';})
      .catch(function(){ /* fall back to the normal add-to-cart path */
        now.removeAttribute('aria-busy'); now.textContent=label; form.submit(); });
  });

  /* Add to bag without leaving the page. The plain form POST reloaded the whole
     site and dumped you on /cart; this keeps you where you are, updates the
     header count and pre-warms /cart so opening the bag is instant. The sticky
     bar's button submits this same form, so it is covered too. Any failure
     falls back to the native submit. */
  var added=document.getElementById('gp-added');
  var warmed=false;
  function warmCart(){
    if(warmed)return; warmed=true;
    var l=document.createElement('link'); l.rel='prefetch'; l.href='/cart'; document.head.appendChild(l);
  }
  function setCount(n){
    var el=document.getElementById('gc-cart-count'); if(el)el.textContent=n;
  }
  if(form)form.addEventListener('submit',function(e){
    if(!window.fetch)return;                 /* let the browser do it the old way */
    e.preventDefault();
    var btn=document.getElementById('gp-buy');
    if(btn&&btn.getAttribute('aria-busy')==='true')return;
    var label=btn?btn.textContent:'';
    if(btn){btn.setAttribute('aria-busy','true');btn.textContent='Adding…';}
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},
      body:JSON.stringify({id:document.getElementById('gp-vid').value,
                           quantity:parseInt(document.getElementById('gp-qty').value,10)||1})})
      .then(function(r){if(!r.ok)throw new Error('add failed');return r.json();})
      .then(function(){return fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json();});})
      .then(function(cart){
        setCount(cart.item_count);
        if(btn){btn.removeAttribute('aria-busy');btn.textContent=label;}
        if(added)added.hidden=false;
        warmCart();
      })
      .catch(function(){
        if(btn){btn.removeAttribute('aria-busy');btn.textContent=label;}
        form.submit();
      });
  });

  /* sticky bar: show once the real Add button has scrolled out of view */
  var sticky=document.getElementById('gp-sticky'),buy=document.getElementById('gp-buy');
  if(sticky&&buy&&'IntersectionObserver' in window){
    new IntersectionObserver(function(en){
      var gone=!en[0].isIntersecting;
      sticky.classList.toggle('on',gone);
      sticky.setAttribute('aria-hidden',gone?'false':'true');
    },{rootMargin:'0px 0px -10% 0px'}).observe(buy);
  }

  /* share — WhatsApp is the default share channel here, not email */
  var url=location.href.split('?')[0];
  var wa=document.getElementById('gp-wa');
  if(wa)wa.href='https://wa.me/?text='+encodeURIComponent({{ product.title | json }}+' — '+url);
  var copy=document.getElementById('gp-copy');
  if(copy)copy.addEventListener('click',function(){
    var done=function(){var t=copy.textContent;copy.textContent='Copied ✓';
      setTimeout(function(){copy.textContent=t;},1600);};
    if(navigator.clipboard)navigator.clipboard.writeText(url).then(done).catch(function(){});
    else done();
  });
})();

  /* ---------- delivery check ----------
     Prefix table, no network call: the PIN never leaves the page, there is no
     key to leak and nothing third-party to go down. CITY covers the metros by
     three digits so the answer is specific where it can be; STATE covers the
     rest by two. Delivery bands come from the zones we actually ship on —
     anything unmatched still gets an honest pan-India answer. */
  var CITY = {
    '110':'Delhi','201':'Noida','122':'Gurugram','160':'Chandigarh','226':'Lucknow',
    '302':'Jaipur','380':'Ahmedabad','395':'Surat','400':'Mumbai','403':'Goa',
    '411':'Pune','440':'Nagpur','452':'Indore','462':'Bhopal','500':'Hyderabad',
    '560':'Bengaluru','600':'Chennai','641':'Coimbatore','682':'Kochi','695':'Thiruvananthapuram',
    '700':'Kolkata','751':'Bhubaneswar','781':'Guwahati','800':'Patna','834':'Ranchi'
  };
  var STATE = {
    '11':'Delhi','12':'Haryana','13':'Haryana','14':'Punjab','15':'Punjab','16':'Punjab',
    '17':'Himachal Pradesh','18':'Jammu & Kashmir','19':'Jammu & Kashmir',
    '20':'Uttar Pradesh','21':'Uttar Pradesh','22':'Uttar Pradesh','23':'Uttar Pradesh',
    '24':'Uttarakhand','25':'Uttar Pradesh','26':'Uttarakhand','27':'Uttar Pradesh','28':'Uttar Pradesh',
    '30':'Rajasthan','31':'Rajasthan','32':'Rajasthan','33':'Rajasthan','34':'Rajasthan',
    '36':'Gujarat','37':'Gujarat','38':'Gujarat','39':'Gujarat',
    '40':'Maharashtra','41':'Maharashtra','42':'Maharashtra','43':'Maharashtra','44':'Maharashtra',
    '45':'Madhya Pradesh','46':'Madhya Pradesh','47':'Madhya Pradesh','48':'Madhya Pradesh','49':'Chhattisgarh',
    '50':'Telangana','51':'Andhra Pradesh','52':'Andhra Pradesh','53':'Andhra Pradesh',
    '56':'Karnataka','57':'Karnataka','58':'Karnataka','59':'Karnataka',
    '60':'Tamil Nadu','61':'Tamil Nadu','62':'Tamil Nadu','63':'Tamil Nadu','64':'Tamil Nadu',
    '67':'Kerala','68':'Kerala','69':'Kerala',
    '70':'West Bengal','71':'West Bengal','72':'West Bengal','73':'West Bengal','74':'West Bengal',
    '75':'Odisha','76':'Odisha','77':'Odisha','78':'Assam','79':'the North East',
    '80':'Bihar','81':'Bihar','82':'Bihar','83':'Jharkhand','84':'Bihar','85':'Bihar'
  };
  var SLOW = {'17':1,'18':1,'19':1,'78':1,'79':1};              /* hills, J&K, North East */
  var NEAR = {'11':1,'12':1,'13':1,'20':1,'21':1,'22':1,'23':1,'25':1,'27':1,'28':1,'30':1,'31':1,'32':1,'33':1,'34':1};

  var pinIn = document.getElementById('gp-pin-in');
  var pinGo = document.getElementById('gp-pin-go');
  var pinOut = document.getElementById('gp-pin-out');
  if (pinIn && pinGo && pinOut) {
    var check = function () {
      var v = (pinIn.value || '').replace(/\D/g, '');
      pinOut.classList.remove('is-bad');
      if (v.length !== 6) {
        pinOut.classList.add('is-bad');
        pinOut.textContent = 'That needs to be a 6-digit PIN code.';
        return;
      }
      var two = v.slice(0, 2), three = v.slice(0, 3);
      var place = CITY[three] || STATE[two];
      var days = SLOW[two] ? '7–10' : (NEAR[two] ? '3–5' : '4–7');
      /* no place name means the sentence has to start on its own */
      var lead = place ? '<b>' + place + '</b> — delivers' : 'Delivers';
      pinOut.innerHTML = lead + ' in <b>' + days +
        ' working days</b>, with tracking. Cash on Delivery available.';
    };
    pinGo.addEventListener('click', check);
    pinIn.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); check(); } });
    pinIn.addEventListener('input', function () {
      pinIn.value = pinIn.value.replace(/\D/g, '').slice(0, 6);
      if (pinIn.value.length === 6) check();
    });
  }
</script>

{% schema %}
{ "name": "GummyChums Product", "settings": [] }
{% endschema %}
