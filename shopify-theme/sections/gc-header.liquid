{%- comment -%} GummyChums header — logo left · nav centred · cart right (three-zone grid) {%- endcomment -%}
<style>
  /* quiet marquee — a detail, not a shouting band */
  .gch-bar{background:var(--c-ink);color:var(--c-bg);overflow:hidden;padding:var(--sp-2) 0}
  .gch-bar .trk{display:inline-flex;white-space:nowrap;font-weight:var(--fw-bold);text-transform:uppercase;
    font-size:var(--fs-xs);letter-spacing:var(--ls-wide);opacity:.85;animation:gchScroll 70s linear infinite}
  .gch-bar .trk span{padding:0 var(--sp-4)}
  @keyframes gchScroll{to{transform:translateX(-50%)}}

  /* calm bar — canvas background, no backdrop-filter (repaints every scroll frame) */
  .gch{position:sticky;top:0;z-index:60;background:var(--c-bg);
    border-bottom:1px solid var(--c-line);height:var(--header-h)}

  /* three-zone grid: logo left · nav centred · cart right — no margin-left:auto */
  .gch-in{max-width:var(--container);margin-inline:auto;padding-inline:var(--gutter);height:100%;
    display:grid;grid-template-columns:1fr auto 1fr;align-items:center;column-gap:var(--sp-5)}

  .gch-logo{display:flex;align-items:center;line-height:0;justify-self:start}
  .gch-logo img{height:clamp(30px,4vw,42px);width:auto;display:block;
    -webkit-user-drag:none;user-select:none;-webkit-touch-callout:none}

  .gch-nav{display:flex;align-items:center;gap:var(--sp-6);justify-self:center}
  .gch-nav a{color:var(--c-ink);text-decoration:none;font-weight:var(--fw-bold);
    font-size:var(--fs-base);position:relative;padding:var(--sp-1) 0}
  .gch-nav a::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;border-radius:var(--r-full);
    background:var(--c-accent);transform:scaleX(0);transform-origin:left;transition:transform var(--dur-2) var(--ease)}
  .gch-nav a:hover{color:var(--c-accent)}
  .gch-nav a:hover::after{transform:scaleX(1)}

  /* cart pill — the ONLY accent element in the header */
  .gch .gch-cart,.gch .gch-cart:link,.gch .gch-cart:visited,.gch .gch-cart:hover,.gch .gch-cart:active{
    color:var(--c-accent-ink);text-decoration:none}
  .gch .gch-cart{justify-self:end;position:relative;display:inline-flex;align-items:center;justify-content:center;
    gap:var(--sp-2);background:var(--c-accent);font-weight:var(--fw-black);font-size:var(--fs-sm);
    letter-spacing:var(--ls-normal);padding:var(--sp-3) var(--sp-5);border-radius:var(--r-full);line-height:1;
    white-space:nowrap;box-sizing:border-box;box-shadow:var(--sh-2);
    transition:transform var(--dur-1) var(--spring),filter var(--dur-2) var(--ease)}
  .gch .gch-cart:hover{filter:brightness(1.08);transform:translateY(-2px)}
  .gch .gch-cart:active{transform:scale(.95)}
  /* label wrapped in its own element so Dawn's ".header a" colour rule can't win over a bare text node */
  .gch .gch-cart-label{color:var(--c-accent-ink);display:inline-block;line-height:1}
  .gch .gch-count{flex:0 0 auto;background:var(--c-accent-ink);color:var(--c-accent);border-radius:var(--r-full);
    min-width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;
    font-size:var(--fs-xs);font-weight:var(--fw-black);padding:0 var(--sp-2);line-height:1;box-sizing:border-box}

  /* each responsive/reduced-motion tweak lives in its own @media block —
     keeps every selector declared exactly once for the design-system linter */
  @media(max-width:749px){.gch-nav{gap:var(--sp-4)}}
  @media(max-width:749px){.gch-nav a.gch-hide{display:none}}
  @media(max-width:749px){.gch .gch-cart{padding:var(--sp-3) var(--sp-4)}}

  @media (prefers-reduced-motion:reduce){.gch-bar .trk{animation:none}}
  @media (prefers-reduced-motion:reduce){.gch-nav a::after{transition:none}}
  @media (prefers-reduced-motion:reduce){.gch .gch-cart{transition:none}}
</style>

{%- if section.settings.show_bar -%}
<div class="gch-bar" aria-hidden="true"><div class="trk">
  {%- for i in (1..8) -%}<span>{{ section.settings.bar_text }}</span>{%- endfor -%}
</div></div>
{%- endif -%}

<header class="gch">
  <div class="gch-in">
    <a href="{{ routes.root_url }}" class="gch-logo" aria-label="{{ shop.name }}">
      <img src="{{ 'gc-wordmark-stack.png' | asset_url }}" alt="{{ shop.name }}" width="4146" height="1550" draggable="false" oncontextmenu="return false">
    </a>
    <nav class="gch-nav">
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <a href="{{ routes.root_url }}#gc-story" class="gch-hide">Story</a>
      <a href="{{ routes.root_url }}#gc-faq" class="gch-hide">FAQ</a>
    </nav>
    <a href="{{ routes.cart_url }}" class="gch-cart">
      <span class="gch-cart-label">BAG</span>
      <span class="gch-count" id="gc-cart-count">{{ cart.item_count }}</span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "GummyChums Header",
  "settings": [
    { "type": "checkbox", "id": "show_bar", "label": "Show top marquee bar", "default": true },
    { "type": "text", "id": "bar_text", "label": "Marquee text",
      "default": "FREE SHIPPING OVER ₹699 ✦ NO ADDED SUGAR ✦ 100% VEG ✦ MADE IN INDIA ✦" }
  ]
}
{% endschema %}
