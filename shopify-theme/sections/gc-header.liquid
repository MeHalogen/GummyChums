{%- comment -%} GummyChums header — brand bar + logo nav + cart {%- endcomment -%}
<style>
  .gch-bar{background:var(--gc-ink);color:var(--gc-cream);overflow:hidden;padding:8px 0}
  .gch-bar .trk{display:inline-flex;white-space:nowrap;font-weight:700;text-transform:uppercase;
    font-size:10px;letter-spacing:.22em;opacity:.9;animation:gchScroll 70s linear infinite}
  .gch-bar .trk span{padding:0 16px}
  @keyframes gchScroll{to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion:reduce){.gch-bar .trk{animation:none}}

  /* solid bg (no backdrop-filter — that repaints the whole bar every scroll frame) */
  .gch{position:sticky;top:0;z-index:60;background:#FDF7F4F2;
    border-bottom:1px solid rgba(25,19,22,.08);will-change:transform;transform:translateZ(0)}
  .gch-in{max-width:1180px;margin:0 auto;padding:14px 22px;display:flex;align-items:center;gap:20px}
  .gch-logo{display:flex;align-items:center;line-height:0;flex:0 0 auto}
  .gch-logo img{height:clamp(30px,4vw,42px);width:auto;display:block;
    -webkit-user-drag:none;user-select:none;-webkit-touch-callout:none}
  .gch-nav{display:flex;align-items:center;gap:26px;margin-left:auto}
  .gch-nav a{color:var(--gc-ink);text-decoration:none;font-weight:700;font-size:.98rem;position:relative;padding:4px 0}
  .gch-nav a::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2.5px;border-radius:99px;
    background:var(--gc-cherry);transform:scaleX(0);transform-origin:left;transition:transform .3s var(--gc-ease)}
  .gch-nav a:hover::after{transform:scaleX(1)}
  .gch-cart{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:9px;
    background:var(--gc-cherry) !important;color:#fff !important;
    font-weight:800;font-size:.88rem;letter-spacing:.06em;text-decoration:none !important;
    padding:11px 20px;border-radius:999px;line-height:1;white-space:nowrap;box-sizing:border-box;
    box-shadow:0 12px 26px -14px rgba(222,29,97,.75);transition:transform .16s var(--gc-spring),background .25s}
  .gch-cart:hover{background:var(--gc-cherry-dk) !important;transform:translateY(-2px)}
  .gch-cart:active{transform:scale(.95)}
  .gch-count{flex:0 0 auto;background:#fff;color:var(--gc-cherry);border-radius:999px;
    min-width:19px;height:19px;display:inline-flex;align-items:center;justify-content:center;
    font-size:.7rem;font-weight:800;padding:0 5px;line-height:1}
  @media(max-width:749px){
    .gch-nav{gap:16px}
    .gch-nav a.gch-hide{display:none}
    .gch-in{padding:12px 16px;gap:12px}
    .gch-cart{padding:10px 15px}
  }
</style>

{%- if section.settings.show_bar -%}
<div class="gch-bar" aria-hidden="true"><div class="trk">
  {%- for i in (1..8) -%}<span>{{ section.settings.bar_text }}</span>{%- endfor -%}
</div></div>
{%- endif -%}

<header class="gch">
  <div class="gch-in">
    <a href="{{ routes.root_url }}" class="gch-logo" aria-label="{{ shop.name }}">
      <img src="{{ 'gc-wordmark-stack.png' | asset_url }}" alt="{{ shop.name }}" width="170" draggable="false" oncontextmenu="return false">
    </a>
    <nav class="gch-nav">
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <a href="{{ routes.root_url }}#gc-story" class="gch-hide">Story</a>
      <a href="{{ routes.root_url }}#gc-faq" class="gch-hide">FAQ</a>
      <a href="{{ routes.cart_url }}" class="gch-cart">
        BAG
        <span class="gch-count" id="gc-cart-count">{{ cart.item_count }}</span>
      </a>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "GummyChums Header",
  "settings": [
    { "type": "checkbox", "id": "show_bar", "label": "Show top marquee bar", "default": true },
    { "type": "text", "id": "bar_text", "label": "Marquee text",
      "default": "FREE SHIPPING OVER ₹699 ✦ NO ADDED SUGAR ✦ 100% VEG ✦ MADE IN INDIA ✦" }
  ]
}
{% endschema %}
