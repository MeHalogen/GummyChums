{%- comment -%} GummyChums homepage — coming-soon vibe, pink-forward, scroll fall-in kept {%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign GPATH = 'M50 3C72 1 95 18 97 42C99 68 82 95 55 97C30 99 5 82 3 55C1 30 26 5 50 3Z' -%}
<style>
  .gc-home{--cherry:#DE1D61;--mango:#8DAA31;--orange:#F9740D;--ink:#191316;--cream:#FDF7F4;
    margin:0 -1.5rem;overflow-x:clip;color:var(--ink)}
  @media(max-width:749px){.gc-home{margin:0 -1rem}}
  .gc-home *{box-sizing:border-box}
  .gc-wrap{max-width:1180px;margin:0 auto;padding:0 22px}

  /* ---------- ACT 1 — hero + scroll fall-in ---------- */
  .gh-stage{position:relative;height:230vh}
  /* transparent so the global fixed flavour background shows through — nothing to repaint */
  .gh-pin{position:sticky;top:0;height:100svh;overflow:hidden;display:grid;place-items:center;
    background:transparent;contain:paint;padding-bottom:4vh}

  .gh-gummy{position:absolute;left:50%;bottom:-14%;width:min(22vw,150px);z-index:1;
    will-change:transform,opacity;backface-visibility:hidden;transform-origin:center bottom;
    opacity:calc(var(--z,0) * 5);
    transform:translate3d(-50%,0,0) scale(calc(1 + var(--z,0) * var(--z,0) * 36))}
  .gh-mid{position:relative;z-index:2;text-align:center;padding:0 22px;
    opacity:calc(1 - var(--z,0) * 2.7);will-change:opacity}
  .gh-logo{display:block;width:min(520px,80vw);height:auto;margin:0 auto 20px;
    -webkit-user-drag:none;user-select:none;-webkit-touch-callout:none;pointer-events:none}
  .gh-tag{font-size:clamp(1.6rem,4.6vw,3rem);font-weight:800;letter-spacing:-.025em;line-height:1.04;margin:0 auto;max-width:17ch}
  .gh-sub{font-size:clamp(1.08rem,2.3vw,1.38rem);font-weight:600;color:#191316cc;margin:16px auto 0;max-width:34ch;line-height:1.45}
  .gh-cta{margin-top:28px;display:inline-flex}
  .gh-pills{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:22px}
  .gh-pill{background:rgba(255,255,255,.94);border-radius:999px;padding:10px 18px;font-size:.82rem;font-weight:800;
    letter-spacing:.04em;box-shadow:0 8px 18px -12px rgba(25,19,22,.45);outline:1px solid rgba(255,255,255,.8);outline-offset:-1px}
  .gh-scroll{margin-top:24px;font-weight:800;letter-spacing:.2em;font-size:.72rem;color:#19131666;
    animation:ghBounce 1.7s ease-in-out infinite}
  @keyframes ghBounce{0%,100%{transform:translateY(0)}50%{transform:translateY(7px)}}
  .gh-reveal{position:absolute;inset:0;z-index:3;display:grid;place-items:center;text-align:center;padding:0 22px;
    color:#fff;opacity:calc((var(--z,0) - .60) * 3.8);pointer-events:none}
  .gh-reveal h2{font-size:clamp(2rem,7vw,4.6rem);font-weight:800;letter-spacing:-.03em;line-height:1;margin:0}
  .gh-reveal p{font-size:clamp(1rem,2.4vw,1.45rem);font-weight:700;margin:16px auto 0;max-width:30ch;opacity:.92}

  /* ---------- ACT 2 — flavours ---------- */
  .gh-sec{padding:clamp(46px,6vw,78px) 0}
  .gh-head{text-align:center;margin-bottom:clamp(28px,4vw,46px)}
  .gh-head h2{font-size:clamp(2rem,5.4vw,3.5rem);font-weight:800;letter-spacing:-.03em;line-height:1.04;margin:10px 0 0}
  .gh-head p{font-size:clamp(1rem,2.1vw,1.2rem);font-weight:600;color:#191316a0;margin:12px auto 0;max-width:40ch}
  .gh-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(16px,2vw,24px)}
  @media(max-width:900px){.gh-grid{grid-template-columns:1fr;max-width:430px;margin:0 auto}}
  .gh-card{background:rgba(255,255,255,.92);border-radius:28px;padding:18px;display:flex;flex-direction:column;gap:12px;
    box-shadow:0 2px 0 rgba(255,255,255,.9) inset, 0 22px 46px -26px rgba(25,19,22,.34);
    outline:1px solid rgba(255,255,255,.75);outline-offset:-1px;
    transition:transform .22s var(--gc-spring),box-shadow .22s}
  .gh-card:hover{transform:translateY(-8px);box-shadow:0 30px 60px -26px rgba(222,29,97,.4)}
  .gh-shot{border-radius:20px;aspect-ratio:1/1;display:grid;place-items:center;overflow:hidden;position:relative}
  .gh-shot img{width:100%;height:100%;object-fit:cover}
  .gh-shot svg{width:66%;height:auto;animation:ghFloat 6s ease-in-out infinite;will-change:transform}
  @keyframes ghFloat{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-15px) rotate(3deg)}}
  .gh-badge{position:absolute;top:12px;left:12px;background:#fff;color:var(--ink);font-size:.68rem;font-weight:800;
    letter-spacing:.1em;text-transform:uppercase;padding:6px 11px;border-radius:999px;box-shadow:0 6px 14px -8px rgba(0,0,0,.4)}
  .gh-name{font-size:1.4rem;font-weight:800;letter-spacing:-.02em;color:var(--ink);text-decoration:none;margin:2px 0 0}
  .gh-desc{font-size:.94rem;font-weight:600;color:#191316a0;margin:0;line-height:1.45;min-height:2.9em}
  .gh-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:auto;padding-top:4px}
  .gh-price{font-size:1.35rem;font-weight:800}
  .gh-add{border:0;cursor:pointer;font-family:inherit;font-weight:800;font-size:.94rem;color:#fff;
    padding:12px 22px;border-radius:999px;transition:transform .14s var(--gc-spring),filter .25s}
  .gh-add:hover{filter:brightness(1.08)} .gh-add:active{transform:scale(.93)}

  /* ---------- ACT 3 — story ---------- */
  .gh-story{background:var(--ink);color:var(--cream);border-radius:34px;padding:clamp(38px,6vw,74px) clamp(24px,4vw,60px);
    position:relative;overflow:hidden;text-align:center}
  .gh-story::before{content:"";position:absolute;inset:0;pointer-events:none;
    background:radial-gradient(48vw 48vw at 10% 0%, rgba(222,29,97,.34), transparent 62%)}
  .gh-story-in{position:relative;z-index:1}
  .gh-story h2{font-size:clamp(1.8rem,5vw,3.2rem);font-weight:800;letter-spacing:-.03em;line-height:1.08;margin:0 auto;max-width:22ch}
  .gh-story h2 em{font-style:normal;color:var(--cherry)}
  .gh-story p{font-size:clamp(1rem,2.1vw,1.2rem);font-weight:600;color:rgba(253,247,244,.78);
    margin:20px auto 0;max-width:46ch;line-height:1.55}
  .gh-vals{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:36px}
  @media(max-width:749px){.gh-vals{grid-template-columns:1fr}}
  .gh-val{background:rgba(253,247,244,.07);border-radius:20px;padding:20px}
  .gh-val b{display:block;font-size:1.05rem;color:var(--cherry);margin-bottom:6px}
  .gh-val span{font-size:.92rem;font-weight:600;color:rgba(253,247,244,.72);line-height:1.45}

  /* ---------- ACT 4 — FAQ ---------- */
  .gh-faq{max-width:760px;margin:0 auto}
  .gh-q{background:rgba(255,255,255,.92);border-radius:20px;margin-bottom:12px;overflow:hidden;
    box-shadow:0 16px 34px -28px rgba(25,19,22,.36);outline:1px solid rgba(255,255,255,.75);outline-offset:-1px}
  .gh-q summary{cursor:pointer;list-style:none;padding:18px 22px;font-weight:800;font-size:1.04rem;
    display:flex;align-items:center;justify-content:space-between;gap:14px}
  .gh-q summary::-webkit-details-marker{display:none}
  .gh-q summary::after{content:"+";font-size:1.5rem;color:var(--cherry);transition:transform .3s var(--gc-ease);line-height:1}
  .gh-q[open] summary::after{transform:rotate(45deg)}
  .gh-q p{margin:0;padding:0 22px 20px;font-weight:600;font-size:.97rem;color:#191316a8;line-height:1.55}

  /* ---------- ACT 5 — closing CTA ---------- */
  .gh-end{text-align:center;padding:clamp(56px,8vw,110px) 22px}
  .gh-end h2{font-size:clamp(2rem,6vw,4rem);font-weight:800;letter-spacing:-.03em;line-height:1.03;margin:0 auto;max-width:16ch}
  .gh-end h2 em{font-style:normal;color:var(--cherry)}
  .gh-end p{font-size:clamp(1rem,2.2vw,1.25rem);font-weight:600;color:#191316a0;margin:16px auto 30px;max-width:36ch}

  @media (prefers-reduced-motion:reduce){
    .gh-stage{height:auto}.gh-pin{position:relative;height:auto;padding:70px 0}
    .gh-gummy{display:none}.gh-mid{opacity:1!important}.gh-reveal{display:none}
  }
</style>

<div class="gc-home">

  <!-- ACT 1 -->
  <header class="gh-stage" id="gh-stage">
    <div class="gh-pin">
      <div class="gh-gummy">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" style="width:100%">
          <defs><radialGradient id="ghHero" cx="38%" cy="30%" r="76%">
            <stop offset="0%" stop-color="#ff5f94"/><stop offset="60%" stop-color="#DE1D61"/><stop offset="100%" stop-color="#a51447"/>
          </radialGradient></defs>
          <path d="{{ GPATH }}" fill="url(#ghHero)"/>
          <ellipse cx="35" cy="27" rx="16" ry="10" fill="#fff" opacity=".5" transform="rotate(-25 35 27)"/>
        </svg>
      </div>

      <div class="gh-mid">
        <img class="gh-logo" src="{{ 'gc-wordmark-stack.png' | asset_url }}" alt="{{ shop.name }}" width="680" draggable="false" oncontextmenu="return false">
        <h1 class="gh-tag">{{ s.headline }}</h1>
        <p class="gh-sub">{{ s.sub }}</p>
        <div class="gh-cta"><a class="gc-btn" href="{{ routes.all_products_collection_url }}">{{ s.cta }}</a></div>
        <div class="gh-pills">
          <span class="gh-pill">🌱 100% Veg</span>
          <span class="gh-pill">🚫 No Added Sugar</span>
          <span class="gh-pill">🇮🇳 Made in India</span>
        </div>
        <div class="gh-scroll">SCROLL ↓</div>
      </div>

      <div class="gh-reveal">
        <div>
          <h2>{{ s.reveal_title }}</h2>
          <p>{{ s.reveal_sub }}</p>
        </div>
      </div>
    </div>
  </header>

  <!-- ACT 2 — flavours -->
  <section class="gh-sec" id="shop">
    <div class="gc-wrap">
      <div class="gh-head gc-rise">
        <p class="gc-kick">{{ s.shop_kicker }}</p>
        <h2>{{ s.shop_title }}</h2>
        <p>{{ s.shop_sub }}</p>
      </div>
      <div class="gh-grid">
        {%- for product in collections.all.products limit: 3 -%}
          {%- assign t = product.title | downcase -%}
          {%- if t contains 'melatonin' or t contains 'sleep' -%}
            {%- assign col = '#DE1D61' -%}{%- assign c2 = '#ff5f94' -%}{%- assign c3 = '#a51447' -%}{%- assign role = 'Sleep' -%}
          {%- elsif t contains 'eye' -%}
            {%- assign col = '#F9740D' -%}{%- assign c2 = '#ffa34d' -%}{%- assign c3 = '#b8500a' -%}{%- assign role = 'Eye care' -%}
          {%- else -%}
            {%- assign col = '#8DAA31' -%}{%- assign c2 = '#c3e05f' -%}{%- assign c3 = '#5f7620' -%}{%- assign role = 'Focus' -%}
          {%- endif -%}
          <div class="gh-card gc-rise" style="transition-delay:{{ forloop.index0 | times: 90 }}ms">
            <a href="{{ product.url }}" class="gh-shot" style="background:{{ col }}16">
              <span class="gh-badge" style="color:{{ col }}">{{ role }}</span>
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}
              {%- else -%}
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ product.title }}">
                  <defs><radialGradient id="g{{ forloop.index }}" cx="38%" cy="30%" r="76%">
                    <stop offset="0%" stop-color="{{ c2 }}"/><stop offset="60%" stop-color="{{ col }}"/><stop offset="100%" stop-color="{{ c3 }}"/>
                  </radialGradient></defs>
                  <path d="{{ GPATH }}" fill="url(#g{{ forloop.index }})"/>
                  <ellipse cx="35" cy="27" rx="16" ry="10" fill="#fff" opacity=".5" transform="rotate(-25 35 27)"/>
                </svg>
              {%- endif -%}
            </a>
            <a href="{{ product.url }}" class="gh-name">{{ product.title }}</a>
            <p class="gh-desc">{{ product.description | strip_html | truncatewords: 15 }}</p>
            <div class="gh-foot">
              <span class="gh-price" style="color:{{ col }}">{{ product.price | money }}</span>
              {%- if product.available -%}
                <form method="post" action="{{ routes.cart_add_url }}">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="gh-add" style="background:{{ col }}">Add</button>
                </form>
              {%- else -%}
                <span class="gh-add" style="background:#bbb;cursor:default">Sold out</span>
              {%- endif -%}
            </div>
          </div>
        {%- else -%}
          <p style="grid-column:1/-1;text-align:center;color:#191316a0">Add products in Shopify — they appear here automatically.</p>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- ACT 3 — story -->
  <section class="gh-sec" id="gc-story" style="padding-top:0">
    <div class="gc-wrap">
      <div class="gh-story gc-rise">
        <div class="gh-story-in">
          <p class="gc-kick" style="color:#fff9">{{ s.story_kicker }}</p>
          <h2>{{ s.story_title | replace: '[', '<em>' | replace: ']', '</em>' }}</h2>
          <p>{{ s.story_body }}</p>
          <div class="gh-vals">
            <div class="gh-val"><b>{{ s.val1_t }}</b><span>{{ s.val1_b }}</span></div>
            <div class="gh-val"><b>{{ s.val2_t }}</b><span>{{ s.val2_b }}</span></div>
            <div class="gh-val"><b>{{ s.val3_t }}</b><span>{{ s.val3_b }}</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ACT 4 — FAQ -->
  <section class="gh-sec" id="gc-faq" style="padding-top:0">
    <div class="gc-wrap">
      <div class="gh-head gc-rise">
        <p class="gc-kick">Good to know</p>
        <h2>Questions, answered.</h2>
      </div>
      <div class="gh-faq gc-rise">
        <details class="gh-q"><summary>How many do I take a day?</summary><p>Two gummies a day, any time that suits you. Your daily chums are waiting — no water, no pills, no fuss.</p></details>
        <details class="gh-q"><summary>Is there added sugar?</summary><p>No added sugar. Just the good stuff, in a gummy you’ll actually look forward to.</p></details>
        <details class="gh-q"><summary>Are they vegetarian?</summary><p>Yes — 100% vegetarian, pectin-based, and made in India in an FSSAI-compliant facility.</p></details>
        <details class="gh-q"><summary>How long until I feel a difference?</summary><p>Wellness is a habit, not a switch. Most Chums take theirs daily for 4–6 weeks to feel the difference. Consistency is the whole point.</p></details>
        <details class="gh-q"><summary>How fast is delivery?</summary><p>We ship pan-India. Orders are usually delivered in 3–7 working days, and you’ll get tracking as soon as it leaves us.</p></details>
      </div>
    </div>
  </section>

  <!-- ACT 5 — closing -->
  <section class="gh-end gc-rise">
    <h2>{{ s.end_title | replace: '[', '<em>' | replace: ']', '</em>' }}</h2>
    <p>{{ s.end_sub }}</p>
    <a class="gc-btn" href="{{ routes.all_products_collection_url }}">{{ s.end_cta }}</a>
  </section>
</div>

<script>
(function(){
  var stage=document.getElementById('gh-stage'); if(!stage)return;
  var tk=false;
  function upd(){var r=stage.getBoundingClientRect();var d=r.height-innerHeight;
    var z=d>0?Math.min(Math.max(-r.top/d,0),1):0;stage.style.setProperty('--z',z.toFixed(4));}
  addEventListener('scroll',function(){if(!tk){requestAnimationFrame(function(){upd();tk=false;});tk=true;}},{passive:true});
  addEventListener('resize',upd);upd();
})();
</script>

{% schema %}
{
  "name": "GummyChums Home",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Not another supplement brand." },
    { "type": "text", "id": "sub", "label": "Subline", "default": "We’re making healthy habits feel good." },
    { "type": "text", "id": "cta", "label": "CTA label", "default": "Shop the flavours →" },
    { "type": "text", "id": "reveal_title", "label": "Scroll reveal title", "default": "WHAT’S INSIDE?" },
    { "type": "text", "id": "reveal_sub", "label": "Scroll reveal sub", "default": "Bacopa · Melatonin · Lutein. Zero junk — just real wellness." },
    { "type": "header", "content": "Flavours" },
    { "type": "text", "id": "shop_kicker", "label": "Kicker", "default": "Three flavours ✦ one happy habit" },
    { "type": "text", "id": "shop_title", "label": "Title", "default": "Meet the three." },
    { "type": "text", "id": "shop_sub", "label": "Sub", "default": "Supplements you’ll actually look forward to." },
    { "type": "header", "content": "Story" },
    { "type": "text", "id": "story_kicker", "label": "Kicker", "default": "Why we exist" },
    { "type": "text", "id": "story_title", "label": "Title (use [ ] for pink)", "default": "Wellness became a [checklist]. We made it a treat." },
    { "type": "textarea", "id": "story_body", "label": "Body", "default": "People don’t quit because they don’t care — they quit because it feels like work. So we made the healthiest thing you do all day the tastiest. A chum is the friend who reminds you. That’s the whole plan." },
    { "type": "text", "id": "val1_t", "label": "Value 1 title", "default": "Joy, non-negotiable" },
    { "type": "text", "id": "val1_b", "label": "Value 1 body", "default": "If it doesn’t make you smile, it doesn’t ship." },
    { "type": "text", "id": "val2_t", "label": "Value 2 title", "default": "Trust you can read" },
    { "type": "text", "id": "val2_b", "label": "Value 2 body", "default": "The label says everything. Every time." },
    { "type": "text", "id": "val3_t", "label": "Value 3 title", "default": "Within reach" },
    { "type": "text", "id": "val3_b", "label": "Value 3 body", "default": "Premium should never mean pricey." },
    { "type": "header", "content": "Closing" },
    { "type": "text", "id": "end_title", "label": "Title (use [ ] for pink)", "default": "Your daily chums are [waiting]." },
    { "type": "text", "id": "end_sub", "label": "Sub", "default": "Three flavours. One happy habit. Start today." },
    { "type": "text", "id": "end_cta", "label": "CTA", "default": "Grab all three →" }
  ],
  "presets": [{ "name": "GummyChums Home" }]
}
{% endschema %}
